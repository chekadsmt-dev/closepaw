+package ai.closepaw.app
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNotEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+class ChatGptProjectAdapterV66Test {
+    @Test
+    fun canonicalResponseIgnoresOnlyTransportWhitespace() {
+        val a = "ROUTE_TASK\nPROJECT_ID: SMT  ROUTE_ID: X"
+        val b = "ROUTE_TASK PROJECT_ID: SMT ROUTE_ID: X"
+        assertEquals(assistantResponseHashV66(a), assistantResponseHashV66(b))
+    }
+
+    @Test
+    fun canonicalResponseRejectsSubstantiveDifference() {
+        assertNotEquals(
+            assistantResponseHashV66("TARGET: 04"),
+            assistantResponseHashV66("TARGET: 05"),
+        )
+    }
+
+    @Test
+    fun managerSurfaceHashChangesWhenNewAssistantTextAppears() {
+        val before = managerSurfaceHashV66(listOf("SMT", "old answer"))
+        val after = managerSurfaceHashV66(listOf("SMT", "old answer", "ROUTE_TASK PROJECT_ID: SMT ROUTE_ID: CP066"))
+        assertNotEquals(before, after)
+    }
+
+    @Test
+    fun managerSurfaceHashNormalizesVisualWhitespace() {
+        assertEquals(
+            managerSurfaceHashV66(listOf("ROUTE_TASK   PROJECT_ID: SMT")),
+            managerSurfaceHashV66(listOf("ROUTE_TASK PROJECT_ID: SMT")),
+        )
+        assertNull(managerSurfaceHashV66(emptyList()))
+    }
+}
