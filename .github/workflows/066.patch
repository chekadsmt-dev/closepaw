+        .filter { it.isNotBlank() }
+        .fold(mutableListOf<String>()) { out, value ->
+            if (out.lastOrNull() != value) out += value
+            out
+        }
+    if (canonical.isEmpty()) return null
+    return ProjectOrchestratorProtocolV58.sha256(canonical.joinToString("\n"))
