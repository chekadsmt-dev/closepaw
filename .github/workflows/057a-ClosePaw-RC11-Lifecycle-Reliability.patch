+package ai.closepaw.app
+
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.ensureActive
+
+/**
+ * RC11 lifecycle helpers for 057a.
+ *
+ * Cancellation is control flow only when the *current owner coroutine* is cancelled. A child
+ * operation is allowed to fail with CancellationException/TimeoutCancellationException while the
+ * owner remains active; that is an operation failure, not a user stop. This follows kotlinx.coroutines
+ * structured-concurrency guidance and prevents runCatching-style cancellation swallowing.
+ */
+internal suspend fun rethrowOwnerCancellationV57(@Suppress("UNUSED_PARAMETER") error: Throwable) {
+    // Owner cancellation is authoritative even when a lower-level library translates the
+    // cancellation into IOException/provider/transport failure. If the owner is still active,
+    // ensureActive() is a no-op and the original error (including a child CancellationException)
+    // remains available to the caller as an operation failure.
+    currentCoroutineContext().ensureActive()
+}
+
+internal suspend fun <T> runSuspendCatchingV57(block: suspend () -> T): Result<T> =
+    try {
+        Result.success(block())
+    } catch (error: Throwable) {
+        rethrowOwnerCancellationV57(error)
+        Result.failure(error)
+    }
+
+internal enum class ActionStageV57(val attemptedOrLater: Boolean) {
+    STARTED(false),
+    BEFORE_CAPTURED(false),
+    TARGET_REVALIDATED(false),
+    PREPARED(false),
+    DISPATCH_REVALIDATED(false),
+    ATTEMPTED(true),
+    DISPATCH_RETURNED(true),
+    POST_OBSERVED(true),
+    RECEIPT_COMMITTED(true),
+}
+
+internal object ActionLifecycleV57 {
+    // Existing model/network transport may legitimately take 180s. UI action execution must not.
+    // Current protocol bounds WAIT to <=10s and post-action stabilization to <=3s; 45s keeps ample
+    // OEM headroom while preventing multi-minute silent action hangs.
+    const val ACTION_HARD_DEADLINE_MS: Long = 45_000L
+    const val MAX_SAFE_PRE_DISPATCH_REPLANS: Int = 2
+
+    fun exactPreparedPending(raw: String?, taskId: String, sequence: Long?): Boolean {
+        if (raw.isNullOrBlank() || sequence == null) return false
+        val parts = raw.split("|")
+        if (parts.size < 6) return false
+        return parts[0] == taskId &&
+            parts[1] == sequence.toString() &&
+            parts[2] == "PREPARED"
+    }
+}
+
+internal class PreparedActionStaleV57Exception(
+    val stage: ActionStageV57,
+    message: String,
+) : IllegalStateException(message)
+
+internal class ActionStageTimeoutV57Exception(
+    val stage: ActionStageV57,
+    val timeoutMs: Long,
+    cause: Throwable? = null,
+) : IllegalStateException(
+    "ACTION_STAGE_TIMEOUT_V57: stage=${stage.name} attempted=${stage.attemptedOrLater} timeoutMs=$timeoutMs",
+    cause,
+)
