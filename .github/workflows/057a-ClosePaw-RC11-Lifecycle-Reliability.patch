+
+    private suspend fun <T> withinActionDeadlineV57(
+        deadlineUptimeMs: Long,
+        stage: ActionStageV57,
+        block: suspend () -> T,
+    ): T {
+        val remaining = deadlineUptimeMs - android.os.SystemClock.uptimeMillis()
+        if (remaining <= 0L) {
+            throw ActionStageTimeoutV57Exception(
+                stage = stage,
+                timeoutMs = ActionLifecycleV57.ACTION_HARD_DEADLINE_MS,
+            )
+        }
+        return try {
+            withTimeout(remaining) { block() }
+        } catch (timeout: TimeoutCancellationException) {
+            // withTimeout uses CancellationException internally. If our owning task was also
+            // cancelled (for example by the user's Stop), owner cancellation wins and must not
+            // be mislabeled as a stage timeout.
+            rethrowOwnerCancellationV57(timeout)
+            throw ActionStageTimeoutV57Exception(
+                stage = stage,
+                timeoutMs = ActionLifecycleV57.ACTION_HARD_DEADLINE_MS,
+                cause = timeout,
+            )
+        }
+    }
