+package ai.closepaw.app
+
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.async
+import kotlinx.coroutines.awaitCancellation
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.withTimeout
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class ActionLifecycleV57Test {
+
+    @Test
+    fun ownerCancellationIsNeverConvertedToResultFailure() = runTest {
+        val entered = CompletableDeferred<Unit>()
+        val deferred = async {
+            runSuspendCatchingV57 {
+                entered.complete(Unit)
+                awaitCancellation()
+            }
+        }
+        entered.await()
+        deferred.cancel(CancellationException("user stop"))
+        try {
+            deferred.await()
+            throw AssertionError("owner cancellation must propagate")
+        } catch (_: CancellationException) {
+            // expected
+        }
+    }
+
+    @Test
+    fun ownerCancellationWinsEvenWhenLowerLayerWrapsCancellationAsFailure() = runTest {
+        val entered = CompletableDeferred<Unit>()
+        val deferred = async {
+            runSuspendCatchingV57<String> {
+                entered.complete(Unit)
+                try {
+                    awaitCancellation()
+                } catch (cancel: CancellationException) {
+                    throw IllegalStateException("transport wrapped cancellation", cancel)
+                }
+            }
+        }
+        entered.await()
+        deferred.cancel(CancellationException("user stop"))
+        try {
+            deferred.await()
+            throw AssertionError("owner cancellation must outrank translated transport failure")
+        } catch (_: CancellationException) {
+            // expected
+        }
+    }
+
+    @Test
+    fun childTimeoutWhileOwnerActiveRemainsOperationFailure() = runTest {
+        val result = runSuspendCatchingV57 {
+            withTimeout(1) {
+                delay(100)
+                "never"
+            }
+        }
+        assertTrue(result.isFailure)
+        assertTrue(result.exceptionOrNull() is CancellationException)
+    }
+
+    @Test
+    fun childCancellationWhileOwnerActiveRemainsOperationFailure() = runTest {
+        val childCancellation = CancellationException("child operation cancelled")
+        val result = runSuspendCatchingV57<String> { throw childCancellation }
+        assertTrue(result.isFailure)
+        assertTrue(result.exceptionOrNull() === childCancellation)
+    }
+
+    @Test
+    fun ordinaryFailureRemainsFailure() = runTest {
+        val result = runSuspendCatchingV57<String> { error("boom") }
+        assertTrue(result.isFailure)
+        assertEquals("boom", result.exceptionOrNull()?.message)
+    }
+
+    @Test
+    fun exactPreparedPendingRejectsAttemptedOrForeignRecords() {
+        val prepared = "task-1|7|PREPARED|SAFE_TO_RETRY|OPEN_APP:Settings|abc"
+        val attempted = "task-1|7|ATTEMPTED|SAFE_TO_RETRY|OPEN_APP:Settings|abc"
+        assertTrue(ActionLifecycleV57.exactPreparedPending(prepared, "task-1", 7L))
+        assertFalse(ActionLifecycleV57.exactPreparedPending(attempted, "task-1", 7L))
+        assertFalse(ActionLifecycleV57.exactPreparedPending(prepared, "task-2", 7L))
+        assertFalse(ActionLifecycleV57.exactPreparedPending(prepared, "task-1", 8L))
+    }
+
+    @Test
+    fun attemptedBoundaryIsExplicit() {
+        assertFalse(ActionStageV57.BEFORE_CAPTURED.attemptedOrLater)
+        assertFalse(ActionStageV57.DISPATCH_REVALIDATED.attemptedOrLater)
+        assertTrue(ActionStageV57.ATTEMPTED.attemptedOrLater)
+        assertTrue(ActionStageV57.POST_OBSERVED.attemptedOrLater)
+    }
+}
