+    private fun collectResponseCopyControls(): List<AccessibilityNodeInfo> {
+        val root = focusedRootOrNull() ?: return emptyList()
+        val out = mutableListOf<AccessibilityNodeInfo>()
+        walk(root) { node ->
+            if (isResponseCopyControl(node)) out += node
+        }
+        return out.distinctBy(::nodeSignature)
+    }
+
+    /**
+     * ChatGPT Android exposes assistant-turn Copy differently across app builds/locales.
+     * An explicit Copy response label is authoritative. A generic Copy/کپی is accepted only when
+     * a nearby assistant response-action toolbar proves it is not a code-block copy button.
+     */
+    private fun isResponseCopyControl(node: AccessibilityNodeInfo): Boolean {
+        if (nodeMatchesExactLabel(node, COPY_RESPONSE_LABELS)) return true
+        if (!nodeMatchesExactLabel(node, GENERIC_COPY_LABELS)) return false
+
+        var current = node.parent
+        repeat(7) {
+            val scope = current ?: return false
+            if (!containsEditableDescendant(scope)) {
+                val copyCount = countRawCopyLabels(scope, limit = 3)
+                val chromeCount = countExactLabels(scope, RESPONSE_CHROME_EVIDENCE_LABELS, limit = 2)
+                if (copyCount == 1 && chromeCount >= 1) return true
+                if (copyCount > 1 && chromeCount >= 1) return false
+            }
+            current = scope.parent
+        }
+        return false
+    }
+
+    private fun countRawCopyLabels(root: AccessibilityNodeInfo, limit: Int): Int {
+        var count = 0
+        walk(root) { node ->
+            if (count >= limit) return@walk
+            if (nodeMatchesExactLabel(node, COPY_RESPONSE_LABELS) || nodeMatchesExactLabel(node, GENERIC_COPY_LABELS)) count++
+        }
+        return count
+    }
+
+    private fun countExactLabels(root: AccessibilityNodeInfo, labels: Set<String>, limit: Int): Int {
+        var count = 0
+        walk(root) { node ->
+            if (count >= limit) return@walk
+            if (nodeMatchesExactLabel(node, labels)) count++
+        }
+        return count
+    }
+
+    fun responseCopyDiagnosticsV61(): String {
+        val explicit = collectExactLabelNodes(COPY_RESPONSE_LABELS).size
+        val generic = collectExactLabelNodes(GENERIC_COPY_LABELS).size
+        val accepted = collectResponseCopyControls().size
+        return "explicit=$explicit;generic=$generic;accepted=$accepted"
+    }
+
     private fun nodeMatchesExactLabel(node: AccessibilityNodeInfo, labels: Set<String>): Boolean {
