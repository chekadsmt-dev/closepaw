+package ai.closepaw.app
+
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.async
+import kotlinx.coroutines.awaitCancellation
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.test.runTest
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class PostPlanGuardV58ATest {
+    @Test
+    fun childTimeoutIsTypedPreDispatchTimeout() = runTest {
+        try {
+            PostPlanGuardV58A.run(timeoutMs = 1L) {
+                delay(100L)
+                "never"
+            }
+            throw AssertionError("expected timeout")
+        } catch (error: PostPlanGateTimeoutV58AException) {
+            assertEquals(1L, error.timeoutMs)
+            assertTrue(error.message.orEmpty().contains("attempted=false"))
+        }
+    }
+
+    @Test
+    fun ownerCancellationStillPropagatesAsCancellation() = runTest {
+        val entered = CompletableDeferred<Unit>()
+        val worker = async {
+            PostPlanGuardV58A.run(timeoutMs = 60_000L) {
+                entered.complete(Unit)
+                awaitCancellation()
+            }
+        }
+        entered.await()
+        worker.cancel(CancellationException("user stop"))
+        try {
+            worker.await()
+            throw AssertionError("owner cancellation must propagate")
+        } catch (_: CancellationException) {
+            // expected
+        }
+    }
+}
