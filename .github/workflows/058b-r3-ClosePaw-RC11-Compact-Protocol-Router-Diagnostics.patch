+    @Synchronized
+    fun resolveAgent(projectId: String, raw: String): AgentRecordV58? {
+        val enabled = enabledAgents(projectId)
+        val trimmed = raw.trim()
+        val directId = ProjectOrchestratorProtocolV58.candidateAgentId(trimmed)
+        if (directId != null) {
+            enabled.singleOrNull { it.agentId == directId }?.let { return it }
+        }
+        enabled.singleOrNull { it.chatTitle == trimmed }?.let { return it }
+        enabled.singleOrNull { it.role.isNotBlank() && it.role == trimmed }?.let { return it }
+        return null
+    }
