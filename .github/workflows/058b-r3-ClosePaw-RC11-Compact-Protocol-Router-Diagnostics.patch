+    @Synchronized
+    fun applyUpdate(update: ProjectUpdateV58): Boolean {
+        val db = writableDatabase
+        val hash = ProjectOrchestratorProtocolV58.sha256(update.rawBlock)
+        db.beginTransaction()
+        try {
+            if (controlAlreadyApplied(db, update.projectId, hash)) {
+                db.setTransactionSuccessful()
+                return false
+            }
+            val project = projectInDb(db, update.projectId)
+                ?: error("Unknown project ${update.projectId}")
+            val oldManagerChat = agentInDb(db, update.projectId, project.managerAgentId)?.chatTitle
+            require(project.version == update.baseVersion) {
+                "Project ${update.projectId} version is ${project.version}, update expected ${update.baseVersion}"
+            }
+            require(update.newVersion == update.baseVersion + 1L) {
+                "NEW_VERSION must equal BASE_VERSION + 1"
+            }
+            val now = System.currentTimeMillis()
+            when (update.op) {
+                ProjectUpdateOpV58.UPSERT_AGENT -> {
+                    val id = requireNotNull(update.agentId)
+                    val title = requireNotNull(update.chatTitle)
+                    upsertAgentInDb(
+                        db,
+                        update.projectId,
+                        ProjectAgentSpecV58(id, title, update.role, update.description),
+                        enabled = true,
+                        now = now,
+                    )
+                }
+                ProjectUpdateOpV58.DISABLE_AGENT -> {
+                    val id = requireNotNull(update.agentId)
+                    require(id != project.managerAgentId) { "Cannot disable current manager agent" }
+                    require(setAgentEnabled(db, update.projectId, id, false, now) == 1) { "Unknown agent $id" }
+                }
+                ProjectUpdateOpV58.ENABLE_AGENT -> {
+                    val id = requireNotNull(update.agentId)
+                    require(setAgentEnabled(db, update.projectId, id, true, now) == 1) { "Unknown agent $id" }
+                }
+                ProjectUpdateOpV58.SET_MANAGER -> {
+                    val id = requireNotNull(update.agentId)
+                    val agent = agentInDb(db, update.projectId, id)
+                        ?: error("Unknown manager candidate $id")
+                    require(agent.enabled) { "Manager candidate $id is disabled" }
+                    val values = ContentValues().apply {
+                        put("manager_agent_id", id)
+                        put("updated_at", now)
+                    }
+                    db.update("projects", values, "project_id = ?", arrayOf(update.projectId))
+                }
+                ProjectUpdateOpV58.RENAME_PROJECT -> {
+                    val values = ContentValues().apply {
+                        put("display_name", requireNotNull(update.displayName))
+                        put("updated_at", now)
+                    }
+                    db.update("projects", values, "project_id = ?", arrayOf(update.projectId))
+                }
+                ProjectUpdateOpV58.SET_PROJECT_ENABLED -> {
+                    val values = ContentValues().apply {
+                        put("enabled", if (requireNotNull(update.enabled)) 1 else 0)
+                        put("updated_at", now)
+                    }
+                    db.update("projects", values, "project_id = ?", arrayOf(update.projectId))
+                }
+            }
+            val managerBoundaryChanged = when (update.op) {
+                ProjectUpdateOpV58.SET_MANAGER -> update.agentId != project.managerAgentId
+                ProjectUpdateOpV58.UPSERT_AGENT ->
+                    update.agentId == project.managerAgentId && update.chatTitle != oldManagerChat
+                ProjectUpdateOpV58.SET_PROJECT_ENABLED -> update.enabled == true && !project.enabled
+                else -> false
+            }
+            if (managerBoundaryChanged) clearManagerResponseCursorInDb(db, update.projectId)
+
+            val versionValues = ContentValues().apply {
+                put("version", update.newVersion)
+                put("config_hash", hash)
+                put("updated_at", now)
+            }
+            db.update("projects", versionValues, "project_id = ?", arrayOf(update.projectId))
+            recordControl(db, update.projectId, hash, "UPDATE:${update.op.name}", now)
+            db.setTransactionSuccessful()
+            return true
+        } finally {
+            db.endTransaction()
+        }
+    }
