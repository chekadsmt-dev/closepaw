+    @Synchronized
+    fun initialize() {
+        val db = writableDatabase
+        db.beginTransaction()
+        try {
+            if (projectCount(db) == 0L) {
+                seedLegacySmt(db)
+            }
+            importLegacySmtRouteLedger(db)
+            db.setTransactionSuccessful()
+        } finally {
+            db.endTransaction()
+        }
+    }
