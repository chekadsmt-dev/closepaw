+    private fun seedLegacySmt(db: SQLiteDatabase) {
+        val now = System.currentTimeMillis()
+        val project = ProjectManifestV58(
+            projectId = "SMT",
+            version = 1,
+            displayName = "SMT",
+            managerAgentId = "00",
+            agents = listOf(
+                ProjectAgentSpecV58("00", "00 — SMT HQ", "SMT HQ"),
+                ProjectAgentSpecV58("01", "01 — SMT Brand & Creative", "Brand & Creative"),
+                ProjectAgentSpecV58("02", "02 — SMT Marketing & Content", "Marketing & Content"),
+                ProjectAgentSpecV58("03", "03 — SMT Legal & IP", "Legal & IP"),
+                ProjectAgentSpecV58("04", "04 — SMT Finance", "Finance"),
+                ProjectAgentSpecV58("05", "05 — SMT Capital & IR", "Capital & IR"),
+                ProjectAgentSpecV58("06", "06 — SMT Business & Growth", "Business & Growth"),
+                ProjectAgentSpecV58("07", "07 — SMT Sales & CRM", "Sales & CRM"),
+                ProjectAgentSpecV58("08", "08 — SMT Architecture & Product", "Architecture & Product"),
+                ProjectAgentSpecV58("09", "09 — SMT Market Intelligence", "Market Intelligence"),
+                ProjectAgentSpecV58("10", "10 — SMT PMO & Operations", "PMO & Operations"),
+                ProjectAgentSpecV58("11", "11 — SMT Systems & Automation", "Systems & Automation"),
+                ProjectAgentSpecV58("12", "12 — SMT Execution Management", "Execution Management"),
+            ),
+            rawBlock = "LEGACY_SMT_SEED_V58",
+        )
+        val values = ContentValues().apply {
+            put("project_id", project.projectId)
+            put("display_name", project.displayName)
+            put("manager_agent_id", project.managerAgentId)
+            put("version", project.version)
+            put("enabled", 1)
+            put("config_hash", ProjectOrchestratorProtocolV58.sha256(project.rawBlock))
+            put("updated_at", now)
+        }
+        db.insertOrThrow("projects", null, values)
+        project.agents.forEach { upsertAgentInDb(db, project.projectId, it, enabled = true, now = now) }
+    }
