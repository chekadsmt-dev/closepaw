+                        parsedRoutes.forEach { parsed ->
+                            try {
+                                val discovered = store.discoverRoute(project, parsed, manager)
+                                trace("ROUTE_DISCOVERED", routeTag(discovered))
+                            } catch (t: Throwable) {
