+                        // Atomic batches can be added later with an explicit batch protocol; do not
+                        // partially apply several manager-authored mutations from one response.
+                        val trustedControlPayload = requireNotNull(controlPlanePayload)
+                        val manifests = ProjectOrchestratorProtocolV58.manifests(trustedControlPayload)
+                            .filter { it.projectId == project.projectId }
+                        val updates = ProjectOrchestratorProtocolV58.updates(trustedControlPayload)
+                            .filter { it.projectId == project.projectId }
+                        if (manifests.size + updates.size != 1) {
+                            trace(
+                                "CONTROL_PLANE_REJECTED",
+                                "project=${project.projectId}|reason=expected_exactly_one_topology_block|manifests=${manifests.size}|updates=${updates.size}",
+                            )
+                        } else if (manifests.size == 1) {
+                            runCatching { store.applyManifest(manifests.single()) }
+                                .onSuccess { changed -> if (changed) trace("MANIFEST_APPLIED", "project=${project.projectId} v=${manifests.single().version}") }
+                                .onFailure { trace("MANIFEST_REJECTED", "project=${project.projectId} error=${it.message}") }
+                        } else {
+                            runCatching { store.applyUpdate(updates.single()) }
+                                .onSuccess { changed -> if (changed) trace("UPDATE_APPLIED", "project=${project.projectId} op=${updates.single().op} v=${updates.single().newVersion}") }
+                                .onFailure { trace("UPDATE_REJECTED", "project=${project.projectId} error=${it.message}") }
+                        }
+                    } else {
