+                    val baseline = ui.latestAssistantResponse()?.trim()?.takeIf { it.isNotBlank() }
+                    if (responseControls > 0 && baseline == null) {
+                        // A response exists but Copy did not produce a positive receipt. Do not
+                        // misclassify this as an empty history and later execute stale commands.
+                        trace("MANAGER_BASELINE_COPY_UNAVAILABLE", "project=${project.projectId}|controls=$responseControls")
+                        return
+                    }
+                    val exactHash = baseline?.let(ProjectOrchestratorProtocolV58::sha256)
+                    store.primeManagerCursor(project.projectId, exactHash, surfaceHash)
+                    trace(
+                        "MANAGER_BASELINE_PRIMED",
+                        "project=${project.projectId}|assistant=${if (exactHash == null) "empty" else exactHash.take(16)}",
+                    )
+                    return
+                }
