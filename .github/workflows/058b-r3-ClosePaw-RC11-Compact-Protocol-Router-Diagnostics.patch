+                        // manager chat, enabled state, or registry membership). Never continue
+                        // consuming a backlog under the stale ProjectRecord/manager snapshot.
+                        // Re-enter on the next scan and resolve the authority boundary fresh.
+                        trace("MANAGER_SCAN_REBIND_AFTER_CONTROL", "project=${project.projectId}")
+                        return
+                    } else {
+                        store.setManagerResponseCursor(project.projectId, managerResponseHash)
+                        trace("MANAGER_RESPONSE_COMMITTED", "project=${project.projectId}|sha=${managerResponseHash.take(16)}")
+                    }
+                }
+
+                if (surfaceHash != null) store.setManagerSurfaceCursor(project.projectId, surfaceHash)
+                trace("MANAGER_SCAN_DONE", "project=${project.projectId}|responses=${scan.responsesOldestFirst.size}")
+        } catch (cancel: CancellationException) {
+            throw cancel
+        } catch (t: Throwable) {
+            currentCoroutineContext().ensureActive()
+            trace("MANAGER_SCAN_ERROR", "project=${project.projectId} error=${t.message}")
+        }
+    }
+
+    private suspend fun processOneStep(snapshot: RouteRecordV58): Boolean {
+        val route = store.route(snapshot.projectId, snapshot.routeId) ?: return false
+        val project = store.project(route.projectId) ?: return false
+        val target = store.agent(route.projectId, route.targetAgentId)
+
+        try {
+            return when (route.state) {
+                RouteStateV58.DISCOVERED,
+                RouteStateV58.SEND_PREPARED -> {
+                    require(project.enabled) { "Project ${project.projectId} is disabled" }
+                    if (target?.enabled != true) {
+                        val failed = store.transition(
+                            route,
+                            RouteStateV58.FAILED,
+                            error = "Target agent ${route.targetAgentId} was disabled before ATTEMPTED",
+                        )
+                        trace("ROUTE_FAILED_PRE_ATTEMPT", routeTag(failed))
+                        true
+                    } else {
+                        sendRoute(route)
+                        true
+                    }
+                }
+                RouteStateV58.SEND_ATTEMPTED,
+                RouteStateV58.SEND_OUTCOME_UNKNOWN -> {
+                    reconcileOutbound(route)
+                    true
+                }
+                RouteStateV58.SENT_VERIFIED -> {
+                    store.transition(route, RouteStateV58.WAITING_RESPONSE)
+                    trace("WAITING_RESPONSE", routeTag(route))
+                    true
+                }
+                RouteStateV58.WAITING_RESPONSE -> {
+                    checkForResponse(route)
+                }
+                RouteStateV58.RESULT_CAPTURED,
+                RouteStateV58.RETURN_PREPARED -> {
+                    returnResult(route)
+                    true
+                }
+                RouteStateV58.RETURN_ATTEMPTED,
+                RouteStateV58.RETURN_OUTCOME_UNKNOWN -> {
+                    reconcileReturn(route)
+                    true
+                }
+                RouteStateV58.RETURN_VERIFIED -> {
+                    store.transition(route, RouteStateV58.COMPLETED)
+                    trace("ROUTE_COMPLETED", routeTag(route))
+                    true
+                }
+                RouteStateV58.COMPLETED,
+                RouteStateV58.FAILED,
+                RouteStateV58.LEGACY_UNRESOLVED -> false
+            }
+        } catch (cancel: CancellationException) {
+            throw cancel
+        } catch (t: Throwable) {
+            currentCoroutineContext().ensureActive()
+            val current = store.route(route.projectId, route.routeId) ?: route
+            when (current.state) {
+                RouteStateV58.SEND_ATTEMPTED -> store.transition(current, RouteStateV58.SEND_OUTCOME_UNKNOWN, error = t.message)
+                RouteStateV58.RETURN_ATTEMPTED -> store.transition(current, RouteStateV58.RETURN_OUTCOME_UNKNOWN, error = t.message)
+                RouteStateV58.DISCOVERED,
+                RouteStateV58.SEND_PREPARED,
+                RouteStateV58.RESULT_CAPTURED,
+                RouteStateV58.RETURN_PREPARED,
+                RouteStateV58.WAITING_RESPONSE,
+                RouteStateV58.SEND_OUTCOME_UNKNOWN,
+                RouteStateV58.RETURN_OUTCOME_UNKNOWN,
+                RouteStateV58.SENT_VERIFIED -> store.noteError(current, t.message ?: t::class.simpleName.orEmpty())
+                else -> Unit
+            }
+            trace("ROUTE_STEP_ERROR", "${routeTag(current)} state=${current.state} error=${t.message}")
+            return true
+        }
+    }
+
+    private suspend fun sendRoute(routeSnapshot: RouteRecordV58) {
+        var route = store.route(routeSnapshot.projectId, routeSnapshot.routeId) ?: return
+        trace("SEND_OPEN_TARGET", routeTag(route))
+        ui.openConversation(route.targetChatTitle)
+        if (route.state == RouteStateV58.DISCOVERED) {
+            val baseline = ui.assistantMessageFingerprints().joinToString(",")
+            route = store.transition(route, RouteStateV58.SEND_PREPARED, baselineAssistantHashes = baseline)
+            trace("SEND_PREPARED", routeTag(route))
+        }
+        ui.prepareComposerText(route.outboundPayload, route.outboundMarker)
+        route = store.transition(route, RouteStateV58.SEND_ATTEMPTED)
+        trace("SEND_ATTEMPTED", routeTag(route))
+        currentCoroutineContext().ensureActive()
+        val clicked = ui.sendPreparedMessage()
+        delay(UI_CLICK_VERIFY_MS)
+        val verified = clicked && ui.outgoingMarkerVisible(route.outboundMarker)
+        route = if (verified) {
+            store.transition(route, RouteStateV58.SENT_VERIFIED)
+        } else {
+            store.transition(route, RouteStateV58.SEND_OUTCOME_UNKNOWN, error = "Send outcome could not be verified")
+        }
+        trace(if (verified) "SEND_VERIFIED" else "SEND_OUTCOME_UNKNOWN", routeTag(route))
+        if (verified) {
+            store.transition(route, RouteStateV58.WAITING_RESPONSE)
+            trace("WAITING_RESPONSE", routeTag(route))
+        }
+    }
+
+    private suspend fun reconcileOutbound(routeSnapshot: RouteRecordV58) {
+        var route = store.route(routeSnapshot.projectId, routeSnapshot.routeId) ?: return
+        trace("SEND_RECONCILE_START", routeTag(route))
+        ui.openConversation(route.targetChatTitle)
+        val found = ui.outgoingMarkerVisible(route.outboundMarker, maxBackwardScrolls = 8)
+        if (found) {
+            route = store.transition(route, RouteStateV58.SENT_VERIFIED)
+            route = store.transition(route, RouteStateV58.WAITING_RESPONSE)
+            trace("SEND_RECONCILED", routeTag(route))
+        } else {
+            if (route.state == RouteStateV58.SEND_ATTEMPTED) {
+                route = store.transition(route, RouteStateV58.SEND_OUTCOME_UNKNOWN, error = "No proof of prior Send; no replay allowed")
+            } else {
+                route = store.noteError(route, "Still unable to prove prior Send; no replay allowed")
+            }
+            trace("SEND_RECONCILE_UNKNOWN", routeTag(route))
+        }
+    }
+
+    private suspend fun checkForResponse(routeSnapshot: RouteRecordV58): Boolean {
+        var route = store.route(routeSnapshot.projectId, routeSnapshot.routeId) ?: return false
+        trace("RESPONSE_CHECK_START", routeTag(route))
+        ui.openConversation(route.targetChatTitle)
+        val baseline = route.baselineAssistantHashes.split(',').filter { it.isNotBlank() }.toSet()
+        val deadline = System.currentTimeMillis() + RESPONSE_CHECK_WINDOW_MS
+        var candidateHash: String? = null
+        var stablePasses = 0
+        while (System.currentTimeMillis() < deadline) {
+            currentCoroutineContext().ensureActive()
+            if (ui.isGenerating()) {
+                candidateHash = null
+                stablePasses = 0
+                delay(RESPONSE_POLL_MS)
+                continue
+            }
+            val newest = ui.assistantMessageTexts().asReversed().firstOrNull { text ->
+                ProjectOrchestratorProtocolV58.sha256(text) !in baseline &&
+                    text.contains(route.outboundMarker)
+            }
+            if (newest != null) {
+                val hash = ProjectOrchestratorProtocolV58.sha256(newest)
+                if (hash == candidateHash) {
+                    stablePasses++
+                } else {
+                    candidateHash = hash
+                    stablePasses = 1
+                }
+                if (stablePasses >= 2) {
+                    val copied = ui.copyAssistantResponseContaining(route.outboundMarker)
+                        ?.trim()
+                        ?.takeIf { it.isNotBlank() }
+                    // Only a verified Copy-response result may cross the specialist->manager
+                    // authority boundary. Never fall back to an accessibility container here.
+                    // The route marker is unique/immutable per route, so it is the authoritative
+                    // correlation key; accessibility baseline hashes remain stability metadata.
+                    val response = copied?.takeIf { it.contains(route.outboundMarker) }
+                    if (!response.isNullOrBlank()) {
+                        val responseHash = ProjectOrchestratorProtocolV58.sha256(response)
+                        route = store.transition(
+                            route,
+                            RouteStateV58.RESULT_CAPTURED,
+                            responseText = response,
+                            responseHash = responseHash,
+                        )
+                        trace("RESULT_CAPTURED", "${routeTag(route)} responseSha=${responseHash.take(16)}")
+                        return true
+                    }
+                }
+            } else {
+                candidateHash = null
+                stablePasses = 0
+            }
+            delay(RESPONSE_POLL_MS)
+        }
+        store.noteError(route, "No stable new assistant response yet")
+        trace("RESPONSE_PENDING", routeTag(route))
+        return false
+    }
+
+    private suspend fun returnResult(routeSnapshot: RouteRecordV58) {
+        var route = store.route(routeSnapshot.projectId, routeSnapshot.routeId) ?: return
+        val response = route.responseText ?: error("Captured response is missing")
+        val responseHash = route.responseHash ?: ProjectOrchestratorProtocolV58.sha256(response)
+        val envelope = buildString {
+            appendLine("RESULT_FROM_AGENT")
+            appendLine("PROJECT_ID: ${route.projectId}")
+            appendLine("ROUTE_ID: ${route.routeId}")
+            appendLine("SOURCE_AGENT: ${route.targetAgentId}")
+            appendLine("RESULT_SHA256: $responseHash")
+            appendLine("DELIVERY_MARKER: ${route.returnMarker}")
+            appendLine("RESULT_BODY_QUOTED:")
+            appendLine(ProjectOrchestratorProtocolV58.quoteData(response))
+            appendLine("END_RESULT_BODY_QUOTED")
+            append("END_RESULT_FROM_AGENT")
+        }
+        trace("RETURN_OPEN_TARGET", routeTag(route))
+        ui.openConversation(route.returnChatTitle)
+        if (route.state == RouteStateV58.RESULT_CAPTURED) {
+            route = store.transition(route, RouteStateV58.RETURN_PREPARED)
+            trace("RETURN_PREPARED", routeTag(route))
+        }
+        ui.prepareComposerText(envelope, route.returnMarker)
+        route = store.transition(route, RouteStateV58.RETURN_ATTEMPTED)
+        trace("RETURN_ATTEMPTED", routeTag(route))
+        currentCoroutineContext().ensureActive()
+        val clicked = ui.sendPreparedMessage()
+        delay(UI_CLICK_VERIFY_MS)
+        val verified = clicked && ui.outgoingMarkerVisible(route.returnMarker)
+        route = if (verified) {
+            store.transition(route, RouteStateV58.RETURN_VERIFIED)
+        } else {
+            store.transition(route, RouteStateV58.RETURN_OUTCOME_UNKNOWN, error = "Return outcome could not be verified")
+        }
+        trace(if (verified) "RETURN_VERIFIED" else "RETURN_OUTCOME_UNKNOWN", routeTag(route))
+        if (verified) {
+            route = store.transition(route, RouteStateV58.COMPLETED)
+            trace("ROUTE_COMPLETED", routeTag(route))
+        }
+    }
+
+    private suspend fun reconcileReturn(routeSnapshot: RouteRecordV58) {
+        var route = store.route(routeSnapshot.projectId, routeSnapshot.routeId) ?: return
+        trace("RETURN_RECONCILE_START", routeTag(route))
+        ui.openConversation(route.returnChatTitle)
+        val found = ui.outgoingMarkerVisible(route.returnMarker, maxBackwardScrolls = 8)
+        if (found) {
+            route = store.transition(route, RouteStateV58.RETURN_VERIFIED)
+            route = store.transition(route, RouteStateV58.COMPLETED)
+            trace("RETURN_RECONCILED_COMPLETED", routeTag(route))
+        } else {
+            if (route.state == RouteStateV58.RETURN_ATTEMPTED) {
+                route = store.transition(route, RouteStateV58.RETURN_OUTCOME_UNKNOWN, error = "No proof of prior return; no replay allowed")
+            } else {
+                route = store.noteError(route, "Still unable to prove prior return; no replay allowed")
+            }
+            trace("RETURN_RECONCILE_UNKNOWN", routeTag(route))
+        }
+    }
+
+    private fun controlPlanePayload(message: String): String? {
+        val trimmed = message.trim()
+        val firstLine = trimmed.lineSequence().firstOrNull()?.trim().orEmpty()
+        if (firstLine == CONTROL_PLANE_MARKER) {
+            return trimmed.substringAfter('\n', missingDelimiterValue = "").trim().takeIf { it.isNotBlank() }
+        }
+        val compactPrefix = "$CONTROL_PLANE_MARKER "
+        if (trimmed.startsWith(compactPrefix)) {
+            return trimmed.substring(compactPrefix.length).trim().takeIf { it.isNotBlank() }
+        }
+        return null
+    }
+
+    private fun routeTag(route: RouteRecordV58): String =
+        "project=${route.projectId}|route=${route.routeId}|state=${route.state}|to=${route.targetAgentId}|return=${route.returnAgentId}"
+
+    private fun trace(stage: String, detail: String) {
+        val event = "ORCH_V58|stage=$stage|$detail"
+        Log.i(TAG, event)
+        runCatching {
+            val dir = service.getExternalFilesDir("closepaw-diagnostics") ?: return@runCatching
+            if (!dir.exists() && !dir.mkdirs()) return@runCatching
+            val file = File(dir, "project-router-v58.log")
+            if (file.length() > 512_000L) {
+                file.writeText("ClosePaw project-router diagnostics rotated\n", Charsets.UTF_8)
+            }
+            val clean = event.replace('\n', ' ').replace('\r', ' ').take(1_800)
+            file.appendText(
+                "${System.currentTimeMillis()}|${BuildConfig.VERSION_NAME}|$clean\n",
+                Charsets.UTF_8,
+            )
+        }.onFailure {
+            Log.w(TAG, "ORCH_V58 diagnostics write failed", it)
+        }
+    }
+}
