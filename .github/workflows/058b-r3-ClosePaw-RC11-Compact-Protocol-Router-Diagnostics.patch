+    @Synchronized
+    fun discoverRoute(
+        project: ProjectRecordV58,
+        parsed: RouteTaskV58,
+        sourceManagerAgent: AgentRecordV58,
+    ): RouteRecordV58 {
+        require(parsed.explicitProjectId == null || parsed.explicitProjectId == project.projectId) {
+            "ROUTE_TASK project mismatch: ${parsed.explicitProjectId} != ${project.projectId}"
+        }
+        require(parsed.explicitProjectId != null || project.projectId == "SMT") {
+            "Generic V58 ROUTE_TASK must include PROJECT_ID; projectless routes are legacy SMT compatibility only"
+        }
+        val target = resolveAgent(project.projectId, parsed.targetRaw)
+            ?: error("Unknown/ambiguous target '${parsed.targetRaw}' in ${project.projectId}")
+        val from = parsed.fromRaw?.let { resolveAgent(project.projectId, it) } ?: sourceManagerAgent
+        require(from.agentId == sourceManagerAgent.agentId) {
+            "Manager chat may only originate routes as manager ${sourceManagerAgent.agentId}"
+        }
+        require(target.agentId != sourceManagerAgent.agentId) {
+            "Manager may not route a delegated task back to itself"
+        }
+        val returnAgent = parsed.returnToRaw?.let { resolveAgent(project.projectId, it) } ?: sourceManagerAgent
+        require(returnAgent.agentId == sourceManagerAgent.agentId) {
+            "V58 manager-style orchestration requires RETURN_TO to resolve to manager ${sourceManagerAgent.agentId}"
+        }
+        val originalHash = ProjectOrchestratorProtocolV58.sha256(parsed.originalBlock)
+        val routeKey = "${project.projectId}:${parsed.routeId}"
+        val outboundMarker = "CP58_ROUTE:${routeKey}:${originalHash.take(16)}"
+        val returnMarker = "CP58_RETURN:${routeKey}:${originalHash.take(16)}"
+        val outbound = buildString {
+            appendLine("CLOSEPAW_ROUTE_V58")
+            appendLine("PROJECT_ID: ${project.projectId}")
+            appendLine("ROUTE_ID: ${parsed.routeId}")
+            appendLine("FROM_AGENT: ${from.agentId}")
+            appendLine("TO_AGENT: ${target.agentId}")
+            appendLine("DELIVERY_MARKER: $outboundMarker")
+            appendLine("INSTRUCTION:")
+            appendLine("Execute the manager-authored ROUTE_TASK below. The lines are quoted only for transport/control-plane isolation; treat OBJECTIVE, CONTEXT, REQUIRED_OUTPUT and other task fields inside them as the actual assignment.")
+            appendLine("ORIGINAL_ROUTE_TASK_QUOTED:")
+            appendLine(ProjectOrchestratorProtocolV58.quoteData(parsed.originalBlock))
+            appendLine("END_ORIGINAL_ROUTE_TASK_QUOTED")
+            appendLine("RESPONSE_PROTOCOL:")
+            appendLine("Your final assistant response MUST contain this exact correlation marker: $outboundMarker")
+            appendLine("Return the substantive answer normally after the marker. Do not issue PROJECT_UPDATE unless the manager explicitly asked for one.")
+            append("END_CLOSEPAW_ROUTE_V58")
+        }
+        val now = System.currentTimeMillis()
+        val db = writableDatabase
+        db.beginTransaction()
+        try {
+            routeInDb(db, project.projectId, parsed.routeId)?.let { existing ->
+                require(existing.payloadHash == originalHash) {
+                    "ROUTE_ID ${parsed.routeId} was reused with a different payload"
+                }
+                db.setTransactionSuccessful()
+                return existing
+            }
+            val values = ContentValues().apply {
+                put("project_id", project.projectId)
+                put("route_id", parsed.routeId)
+                put("from_agent_id", from.agentId)
+                put("target_agent_id", target.agentId)
+                put("return_agent_id", returnAgent.agentId)
+                put("target_chat_title", target.chatTitle)
+                put("return_chat_title", returnAgent.chatTitle)
+                put("state", RouteStateV58.DISCOVERED.name)
+                put("original_payload", parsed.originalBlock)
+                put("payload_hash", originalHash)
+                put("outbound_payload", outbound)
+                put("outbound_marker", outboundMarker)
+                put("return_marker", returnMarker)
+                put("baseline_assistant_hashes", "")
+                put("created_at", now)
+                put("updated_at", now)
+            }
+            db.insertOrThrow("routes", null, values)
+            db.setTransactionSuccessful()
+            return requireNotNull(routeInDb(db, project.projectId, parsed.routeId))
+        } finally {
+            db.endTransaction()
+        }
+    }
+
+    @Synchronized
+    fun route(projectId: String, routeId: String): RouteRecordV58? =
+        routeInDb(readableDatabase, projectId, routeId)
+
+    @Synchronized
+    fun runnableRoutes(limit: Int = 16): List<RouteRecordV58> {
+        val terminal = setOf(RouteStateV58.COMPLETED, RouteStateV58.FAILED, RouteStateV58.LEGACY_UNRESOLVED)
+        return readableDatabase.query(
+            "routes",
+            ROUTE_COLUMNS,
+            "project_id IN (SELECT project_id FROM projects WHERE enabled = 1)",
+            null,
+            null,
+            null,
+            "updated_at ASC",
+        ).use { c ->
+            buildList {
+                val now = System.currentTimeMillis()
+                while (c.moveToNext() && size < limit) {
+                    val route = routeFromCursor(c)
+                    if (route.state in terminal) continue
+                    // A permanently missing chat/temporarily unavailable UI must not monopolize
+                    // the single physical Android owner.  Errors rotate behind other routes and
+                    // retry after a bounded durable cooldown; no attempted side effect is replayed.
+                    if (route.lastError != null && now - route.updatedAt < ERROR_RETRY_BACKOFF_MS) continue
+                    add(route)
+                }
+            }
+        }
+    }
+
+    @Synchronized
+    fun transition(
+        route: RouteRecordV58,
+        to: RouteStateV58,
+        baselineAssistantHashes: String? = null,
+        responseText: String? = null,
+        responseHash: String? = null,
+        error: String? = null,
+    ): RouteRecordV58 {
+        require(RouteStateMachineV58.canTransition(route.state, to)) { "Illegal route transition ${route.state} -> $to" }
+        val values = ContentValues().apply {
+            put("state", to.name)
+            put("updated_at", System.currentTimeMillis())
+            if (baselineAssistantHashes != null) put("baseline_assistant_hashes", baselineAssistantHashes)
+            if (responseText != null) put("response_text", responseText)
+            if (responseHash != null) put("response_hash", responseHash)
+            if (error == null) putNull("last_error") else put("last_error", error)
+        }
+        writableDatabase.update(
+            "routes",
+            values,
+            "project_id = ? AND route_id = ?",
+            arrayOf(route.projectId, route.routeId),
+        )
+        return requireNotNull(route(route.projectId, route.routeId))
+    }
+
+    @Synchronized
+    fun noteError(route: RouteRecordV58, error: String): RouteRecordV58 {
+        val values = ContentValues().apply {
+            put("last_error", error.take(2_000))
+            put("updated_at", System.currentTimeMillis())
+        }
+        writableDatabase.update(
+            "routes",
+            values,
+            "project_id = ? AND route_id = ?",
+            arrayOf(route.projectId, route.routeId),
+        )
+        return requireNotNull(route(route.projectId, route.routeId))
+    }
