+    }
+
+    private fun parseCompactManifest(block: String): ProjectManifestV58? {
+        val fields = parseCompactFields(
+            block = block,
+            start = "PROJECT_MANIFEST",
+            end = "END_PROJECT_MANIFEST",
+            keys = listOf("PROJECT_ID", "VERSION", "DISPLAY_NAME", "MANAGER_AGENT", "AGENT"),
+            repeatableKeys = setOf("AGENT"),
+        ) ?: return null
+        val projectId = fields.one("PROJECT_ID") ?: return null
+        val version = fields.one("VERSION")?.toLongOrNull() ?: return null
+        val displayName = fields.one("DISPLAY_NAME") ?: projectId
+        val managerAgent = fields.one("MANAGER_AGENT") ?: return null
+        if (!validProjectId(projectId) || !validAgentId(managerAgent) || version < 1L) return null
+
+        val agents = fields.all("AGENT").map { raw ->
+            val parts = raw.split('|', limit = 4).map { it.trim() }
+            if (parts.size < 2) return null
+            val id = parts[0]
+            val title = parts[1]
+            if (!validAgentId(id) || title.isBlank()) return null
+            ProjectAgentSpecV58(
+                agentId = id,
+                chatTitle = title,
+                role = parts.getOrNull(2).orEmpty(),
+                description = parts.getOrNull(3).orEmpty(),
+            )
+        }
+        if (agents.isEmpty()) return null
+        if (agents.map { it.agentId }.distinct().size != agents.size) return null
+        if (agents.none { it.agentId == managerAgent }) return null
+        return ProjectManifestV58(
+            projectId = projectId,
+            version = version,
+            displayName = displayName,
+            managerAgentId = managerAgent,
+            agents = agents,
+            rawBlock = fields.block,
+        )
+    }
+
+    private fun parseCompactFields(
+        block: String,
+        start: String,
+        end: String,
+        keys: List<String>,
+        repeatableKeys: Set<String>,
+    ): CompactFieldsV58? {
+        val compact = collapseTransportWhitespace(block).trim()
+        if (!startsWithToken(compact, start) || !endsWithToken(compact, end)) return null
+        val body = compact
+            .removePrefixIgnoreCase(start)
+            ?.removeSuffixIgnoreCase(end)
+            ?.trim()
+            ?: return null
+        if (body.isBlank()) return null
+
+        val keyAlternation = keys.sortedByDescending { it.length }.joinToString("|") { Regex.escape(it) }
+        val keyRegex = Regex("(?i)(?:^|\\s)($keyAlternation)\\s*:\\s*")
+        val matches = keyRegex.findAll(body).toList()
+        if (matches.isEmpty()) return null
+        if (body.substring(0, matches.first().range.first).trim().isNotEmpty()) return null
+
+        val values = linkedMapOf<String, MutableList<String>>()
+        for ((index, match) in matches.withIndex()) {
+            val key = match.groupValues[1].uppercase()
+            val valueStart = match.range.last + 1
+            val valueEndExclusive = matches.getOrNull(index + 1)?.range?.first ?: body.length
+            val value = body.substring(valueStart, valueEndExclusive).trim()
+            if (value.isBlank()) return null
+            val bucket = values.getOrPut(key) { mutableListOf() }
+            bucket += value
+            if (key !in repeatableKeys && bucket.size > 1) return null
+        }
+        return CompactFieldsV58(compact, values)
+    }
+
+    private fun collapseTransportWhitespace(value: String): String =
+        value.replace(Regex("[\\t\\r\\n ]+"), " ").trim()
+
+    private fun startsWithToken(value: String, token: String): Boolean {
+        if (!value.startsWith(token, ignoreCase = true)) return false
+        return value.length == token.length || value[token.length].isWhitespace()
+    }
+
+    private fun endsWithToken(value: String, token: String): Boolean {
+        if (!value.endsWith(token, ignoreCase = true)) return false
+        val start = value.length - token.length
+        return start == 0 || value[start - 1].isWhitespace()
+    }
+
+    private fun String.removePrefixIgnoreCase(prefix: String): String? =
+        if (startsWith(prefix, ignoreCase = true)) substring(prefix.length) else null
+
+    private fun String.removeSuffixIgnoreCase(suffix: String): String? =
+        if (endsWith(suffix, ignoreCase = true)) substring(0, length - suffix.length) else null
+
+    private fun parseManifest(block: String): ProjectManifestV58? {
+        val lines = normalizedLines(block)
+        if (fieldCount(lines, "PROJECT_ID") != 1 ||
+            fieldCount(lines, "VERSION") != 1 ||
+            fieldCount(lines, "MANAGER_AGENT") != 1 ||
+            fieldCount(lines, "DISPLAY_NAME") > 1
+        ) return null
+        val projectId = field(lines, "PROJECT_ID") ?: return null
+        val version = field(lines, "VERSION")?.toLongOrNull() ?: return null
+        val displayName = field(lines, "DISPLAY_NAME") ?: projectId
+        val managerAgent = field(lines, "MANAGER_AGENT") ?: return null
+        if (!validProjectId(projectId) || !validAgentId(managerAgent) || version < 1L) return null
+
+        val agentLines = lines.filter { line ->
+            val idx = line.indexOf(':')
+            idx > 0 && line.substring(0, idx).trim().equals("AGENT", true)
+        }
+        if (agentLines.isEmpty()) return null
+        val agents = mutableListOf<ProjectAgentSpecV58>()
+        for (line in agentLines) {
+            val idx = line.indexOf(':')
+            val parts = line.substring(idx + 1).split('|', limit = 4).map { it.trim() }
+            if (parts.size < 2) return null
+            val id = parts[0]
+            val title = parts[1]
+            if (!validAgentId(id) || title.isBlank()) return null
+            agents += ProjectAgentSpecV58(
+                agentId = id,
+                chatTitle = title,
+                role = parts.getOrNull(2).orEmpty(),
+                description = parts.getOrNull(3).orEmpty(),
+            )
+        }
+        if (agents.map { it.agentId }.distinct().size != agents.size) return null
+        if (agents.none { it.agentId == managerAgent }) return null
+
+        return ProjectManifestV58(
+            projectId = projectId,
+            version = version,
+            displayName = displayName,
+            managerAgentId = managerAgent,
+            agents = agents,
+            rawBlock = block.trim(),
+        )
+    }
+
+    private fun parseUpdate(block: String): ProjectUpdateV58? {
+        val lines = normalizedLines(block)
+        if (fieldCount(lines, "PROJECT_ID") != 1 ||
+            fieldCount(lines, "BASE_VERSION") != 1 ||
+            fieldCount(lines, "NEW_VERSION") != 1 ||
+            fieldCount(lines, "OP") != 1 ||
+            fieldCount(lines, "AGENT_ID") > 1 ||
+            fieldCount(lines, "CHAT_TITLE") > 1 ||
+            fieldCount(lines, "ROLE") > 1 ||
+            fieldCount(lines, "DESCRIPTION") > 1 ||
+            fieldCount(lines, "DISPLAY_NAME") > 1 ||
+            fieldCount(lines, "ENABLED") > 1
+        ) return null
+        val projectId = field(lines, "PROJECT_ID") ?: return null
+        val baseVersion = field(lines, "BASE_VERSION")?.toLongOrNull() ?: return null
+        val newVersion = field(lines, "NEW_VERSION")?.toLongOrNull() ?: return null
+        val op = field(lines, "OP")?.uppercase()?.let { runCatching { ProjectUpdateOpV58.valueOf(it) }.getOrNull() }
+            ?: return null
+        if (!validProjectId(projectId) || baseVersion < 1L || newVersion != baseVersion + 1L) return null
+
+        val agentId = field(lines, "AGENT_ID")
+        val chatTitle = field(lines, "CHAT_TITLE")
+        val enabled = field(lines, "ENABLED")?.let {
+            when (it.lowercase()) {
+                "true", "1", "yes", "on" -> true
+                "false", "0", "no", "off" -> false
+                else -> return null
+            }
+        }
+
+        when (op) {
+            ProjectUpdateOpV58.UPSERT_AGENT -> if (agentId == null || !validAgentId(agentId) || chatTitle.isNullOrBlank()) return null
+            ProjectUpdateOpV58.DISABLE_AGENT,
+            ProjectUpdateOpV58.ENABLE_AGENT,
+            ProjectUpdateOpV58.SET_MANAGER -> if (agentId == null || !validAgentId(agentId)) return null
+            ProjectUpdateOpV58.RENAME_PROJECT -> if (field(lines, "DISPLAY_NAME").isNullOrBlank()) return null
+            ProjectUpdateOpV58.SET_PROJECT_ENABLED -> if (enabled == null) return null
+        }
+
+        return ProjectUpdateV58(
+            projectId = projectId,
+            baseVersion = baseVersion,
+            newVersion = newVersion,
+            op = op,
+            agentId = agentId,
+            chatTitle = chatTitle,
+            role = field(lines, "ROLE").orEmpty(),
+            description = field(lines, "DESCRIPTION").orEmpty(),
+            displayName = field(lines, "DISPLAY_NAME"),
+            enabled = enabled,
+            rawBlock = block.trim(),
+        )
+    }
+
+    private fun parseRoute(block: String): RouteTaskV58? {
+        val lines = normalizedLines(block)
+        if (fieldCount(lines, "ROUTE_ID") != 1 ||
+            fieldCount(lines, "PROJECT_ID") > 1 ||
+            fieldCount(lines, "TARGET_ID", "TARGET") != 1 ||
+            fieldCount(lines, "FROM_AGENT", "FROM") > 1 ||
+            fieldCount(lines, "RETURN_TO") > 1
+        ) return null
+        val routeId = field(lines, "ROUTE_ID") ?: return null
+        val target = field(lines, "TARGET_ID") ?: field(lines, "TARGET") ?: return null
+        val projectId = field(lines, "PROJECT_ID")
+        if (!validRouteId(routeId) || (projectId != null && !validProjectId(projectId))) return null
+        return RouteTaskV58(
+            explicitProjectId = projectId,
+            routeId = routeId,
+            fromRaw = field(lines, "FROM_AGENT") ?: field(lines, "FROM"),
+            targetRaw = target,
+            returnToRaw = field(lines, "RETURN_TO"),
+            originalBlock = block.trim(),
+        )
+    }
+
+    internal fun candidateAgentId(raw: String): String? {
+        val trimmed = raw.trim()
+        if (validAgentId(trimmed)) return trimmed
+        val separators = listOf(" — ", " – ", " - ", ":", "|")
+        for (separator in separators) {
+            val prefix = trimmed.substringBefore(separator, missingDelimiterValue = "").trim()
+            if (prefix.isNotEmpty() && validAgentId(prefix)) return prefix
+        }
+        return null
+    }
+
+
+    private fun fieldCount(lines: List<String>, key: String): Int =
+        lines.count { line ->
+            val idx = line.indexOf(':')
+            idx > 0 && line.substring(0, idx).trim().equals(key, true)
+        }
+
+    private fun fieldCount(lines: List<String>, vararg keys: String): Int =
+        keys.sumOf { fieldCount(lines, it) }
+
+    private fun field(lines: List<String>, key: String): String? {
+        for (line in lines) {
+            val idx = line.indexOf(':')
+            if (idx <= 0) continue
+            if (!line.substring(0, idx).trim().equals(key, true)) continue
+            return line.substring(idx + 1).trim().takeIf { it.isNotBlank() }
+        }
+        return null
+    }
+
+    private fun normalizedLines(block: String): List<String> =
+        block.lineSequence().map { it.trim() }.filter { it.isNotBlank() }.toList()
+
+    private fun validProjectId(value: String): Boolean = projectIdPattern.matches(value)
+    private fun validAgentId(value: String): Boolean = agentIdPattern.matches(value)
+    private fun validRouteId(value: String): Boolean = routeIdPattern.matches(value)
+}
