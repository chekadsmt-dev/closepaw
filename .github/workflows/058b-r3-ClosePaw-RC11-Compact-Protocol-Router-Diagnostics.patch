+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class ProjectOrchestratorProtocolV58Test {
+
+    @Test
+    fun manifestSupportsArbitraryProjectAndTwentyAgentsWithoutCodeChanges() {
+        val agents = (0..20).joinToString("\n") { i ->
+            val id = i.toString().padStart(2, '0')
+            "AGENT: $id | $id — Example Unit $id | Role $id"
+        }
+        val text = """
+            PROJECT_MANIFEST
+            PROJECT_ID: EXAMPLE
+            VERSION: 1
+            DISPLAY_NAME: Example Project
+            MANAGER_AGENT: 00
+            $agents
+            END_PROJECT_MANIFEST
+        """.trimIndent()
+
+        val manifest = ProjectOrchestratorProtocolV58.manifests(text).single()
+        assertEquals("EXAMPLE", manifest.projectId)
+        assertEquals("00", manifest.managerAgentId)
+        assertEquals(21, manifest.agents.size)
+        assertEquals("20 — Example Unit 20", manifest.agents.last().chatTitle)
+    }
+
+    @Test
+    fun runtimeUpdateIsVersionGatedAndSupportsNonNumericAgentIds() {
+        val text = """
+            PROJECT_UPDATE
+            PROJECT_ID: SKYCLINIC
