+            put("project_id", projectId)
+            put("agent_id", spec.agentId)
+            put("chat_title", spec.chatTitle)
+            put("role", spec.role)
+            put("description", spec.description)
+            put("enabled", if (enabled) 1 else 0)
+            put("updated_at", now)
+        }
+        db.insertWithOnConflict("agents", null, values, SQLiteDatabase.CONFLICT_REPLACE)
+    }
+
+    private fun setAgentEnabled(db: SQLiteDatabase, projectId: String, agentId: String, enabled: Boolean, now: Long): Int {
+        val values = ContentValues().apply {
+            put("enabled", if (enabled) 1 else 0)
+            put("updated_at", now)
+        }
+        return db.update("agents", values, "project_id = ? AND agent_id = ?", arrayOf(projectId, agentId))
+    }
+
+    private fun projectInDb(db: SQLiteDatabase, projectId: String): ProjectRecordV58? =
+        db.query("projects", PROJECT_COLUMNS, "project_id = ?", arrayOf(projectId), null, null, null, "1")
+            .use { c -> if (c.moveToFirst()) projectFromCursor(c) else null }
+
+    private fun agentInDb(db: SQLiteDatabase, projectId: String, agentId: String): AgentRecordV58? =
+        db.query(
+            "agents",
+            AGENT_COLUMNS,
+            "project_id = ? AND agent_id = ?",
+            arrayOf(projectId, agentId),
+            null, null, null, "1",
+        ).use { c -> if (c.moveToFirst()) agentFromCursor(c) else null }
+
+    private fun routeInDb(db: SQLiteDatabase, projectId: String, routeId: String): RouteRecordV58? =
+        db.query(
+            "routes",
+            ROUTE_COLUMNS,
+            "project_id = ? AND route_id = ?",
+            arrayOf(projectId, routeId),
+            null, null, null, "1",
+        ).use { c -> if (c.moveToFirst()) routeFromCursor(c) else null }
+
+    private fun projectFromCursor(c: Cursor) = ProjectRecordV58(
+        projectId = c.getString(0),
+        displayName = c.getString(1),
+        managerAgentId = c.getString(2),
+        version = c.getLong(3),
+        enabled = c.getInt(4) != 0,
+    )
+
+    private fun agentFromCursor(c: Cursor) = AgentRecordV58(
+        projectId = c.getString(0),
+        agentId = c.getString(1),
+        chatTitle = c.getString(2),
+        role = c.getString(3),
+        description = c.getString(4),
+        enabled = c.getInt(5) != 0,
+    )
+
+    private fun routeFromCursor(c: Cursor) = RouteRecordV58(
+        projectId = c.getString(0),
+        routeId = c.getString(1),
+        fromAgentId = c.getString(2),
+        targetAgentId = c.getString(3),
+        returnAgentId = c.getString(4),
+        targetChatTitle = c.getString(5),
+        returnChatTitle = c.getString(6),
+        state = RouteStateV58.valueOf(c.getString(7)),
+        originalPayload = c.getString(8),
+        payloadHash = c.getString(9),
+        outboundPayload = c.getString(10),
+        outboundMarker = c.getString(11),
+        returnMarker = c.getString(12),
+        baselineAssistantHashes = c.getString(13).orEmpty(),
+        responseText = c.getString(14),
+        responseHash = c.getString(15),
+        lastError = c.getString(16),
+        createdAt = c.getLong(17),
+        updatedAt = c.getLong(18),
+    )
+
+    private val PROJECT_COLUMNS = arrayOf("project_id", "display_name", "manager_agent_id", "version", "enabled")
+    private val AGENT_COLUMNS = arrayOf("project_id", "agent_id", "chat_title", "role", "description", "enabled")
+    private val ROUTE_COLUMNS = arrayOf(
+        "project_id", "route_id", "from_agent_id", "target_agent_id", "return_agent_id", "target_chat_title", "return_chat_title", "state",
+        "original_payload", "payload_hash", "outbound_payload", "outbound_marker", "return_marker",
+        "baseline_assistant_hashes", "response_text", "response_hash", "last_error", "created_at", "updated_at",
+    )
+}
