+    private fun importLegacySmtRouteLedger(db: SQLiteDatabase) {
+        val markerHash = ProjectOrchestratorProtocolV58.sha256("LEGACY_IMPORT_V58")
+        if (controlAlreadyApplied(db, "SMT", markerHash)) return
+        val path: File = context.getDatabasePath(LEGACY_DB_NAME)
+        if (path.exists()) {
+            val legacy = SQLiteDatabase.openDatabase(path.path, null, SQLiteDatabase.OPEN_READONLY)
+            try {
+                if (tableExists(legacy, "routes")) {
+                    legacy.query(
+                        "routes",
+                        arrayOf("route_id", "target", "state", "payload_hash", "last_error", "updated_at"),
+                        null, null, null, null, null,
+                    ).use { c ->
+                        while (c.moveToNext()) {
+                            val routeId = c.getString(0) ?: continue
+                            val target = c.getString(1) ?: continue
+                            val legacyState = c.getString(2).orEmpty()
+                            val payloadHash = c.getString(3).orEmpty().ifBlank { ProjectOrchestratorProtocolV58.sha256("legacy:$routeId") }
+                            if (routeInDb(db, "SMT", routeId) != null) continue
+                            val state = when (legacyState) {
+                                "RETURNED_TO_00" -> RouteStateV58.COMPLETED
+                                "FAILED" -> RouteStateV58.FAILED
+                                else -> RouteStateV58.LEGACY_UNRESOLVED
+                            }
+                            val now = c.getLong(5).takeIf { it > 0 } ?: System.currentTimeMillis()
+                            val marker = "LEGACY:$routeId:${payloadHash.take(16)}"
+                            val values = ContentValues().apply {
+                                put("project_id", "SMT")
+                                put("route_id", routeId)
+                                put("from_agent_id", "00")
+                                put("target_agent_id", target)
+                                put("return_agent_id", "00")
+                                put("target_chat_title", agentInDb(db, "SMT", target)?.chatTitle ?: target)
+                                put("return_chat_title", agentInDb(db, "SMT", "00")?.chatTitle ?: "00 — SMT HQ")
+                                put("state", state.name)
+                                put("original_payload", "LEGACY_ROUTE_IMPORTED")
+                                put("payload_hash", payloadHash)
+                                put("outbound_payload", "LEGACY_ROUTE_IMPORTED")
+                                put("outbound_marker", marker)
+                                put("return_marker", "LEGACY_RETURN:$routeId:${payloadHash.take(16)}")
+                                put("baseline_assistant_hashes", "")
+                                put("last_error", c.getString(4))
+                                put("created_at", now)
+                                put("updated_at", now)
+                            }
+                            db.insertWithOnConflict("routes", null, values, SQLiteDatabase.CONFLICT_IGNORE)
+                        }
+                    }
+                }
+            } finally {
+                legacy.close()
+            }
+        }
+        recordControl(db, "SMT", markerHash, "LEGACY_IMPORT", System.currentTimeMillis())
+    }
