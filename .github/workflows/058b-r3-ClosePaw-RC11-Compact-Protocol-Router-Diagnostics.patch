+package ai.closepaw.app
+
+import java.security.MessageDigest
+
+
+internal enum class RouteStateV58 {
+    DISCOVERED,
+    SEND_PREPARED,
+    SEND_ATTEMPTED,
+    SEND_OUTCOME_UNKNOWN,
+    SENT_VERIFIED,
+    WAITING_RESPONSE,
+    RESULT_CAPTURED,
+    RETURN_PREPARED,
+    RETURN_ATTEMPTED,
+    RETURN_OUTCOME_UNKNOWN,
+    RETURN_VERIFIED,
+    COMPLETED,
+    FAILED,
+    LEGACY_UNRESOLVED,
+}
+
+internal object RouteStateMachineV58 {
+    fun canTransition(from: RouteStateV58, to: RouteStateV58): Boolean {
+        if (from == to) return true
+        return when (from) {
+            RouteStateV58.DISCOVERED -> to == RouteStateV58.SEND_PREPARED || to == RouteStateV58.FAILED
+            RouteStateV58.SEND_PREPARED -> to == RouteStateV58.SEND_ATTEMPTED || to == RouteStateV58.FAILED
+            RouteStateV58.SEND_ATTEMPTED -> to == RouteStateV58.SENT_VERIFIED || to == RouteStateV58.SEND_OUTCOME_UNKNOWN
+            RouteStateV58.SEND_OUTCOME_UNKNOWN -> to == RouteStateV58.SENT_VERIFIED
+            RouteStateV58.SENT_VERIFIED -> to == RouteStateV58.WAITING_RESPONSE
+            RouteStateV58.WAITING_RESPONSE -> to == RouteStateV58.RESULT_CAPTURED
+            RouteStateV58.RESULT_CAPTURED -> to == RouteStateV58.RETURN_PREPARED
+            RouteStateV58.RETURN_PREPARED -> to == RouteStateV58.RETURN_ATTEMPTED || to == RouteStateV58.FAILED
+            RouteStateV58.RETURN_ATTEMPTED -> to == RouteStateV58.RETURN_VERIFIED || to == RouteStateV58.RETURN_OUTCOME_UNKNOWN
+            RouteStateV58.RETURN_OUTCOME_UNKNOWN -> to == RouteStateV58.RETURN_VERIFIED
+            RouteStateV58.RETURN_VERIFIED -> to == RouteStateV58.COMPLETED
+            RouteStateV58.COMPLETED,
+            RouteStateV58.FAILED,
+            RouteStateV58.LEGACY_UNRESOLVED -> false
+        }
+    }
+}
+
+internal data class ProjectAgentSpecV58(
+    val agentId: String,
+    val chatTitle: String,
+    val role: String = "",
+    val description: String = "",
+)
+
+internal data class ProjectManifestV58(
+    val projectId: String,
+    val version: Long,
+    val displayName: String,
+    val managerAgentId: String,
+    val agents: List<ProjectAgentSpecV58>,
+    val rawBlock: String,
+)
+
+internal enum class ProjectUpdateOpV58 {
+    UPSERT_AGENT,
+    DISABLE_AGENT,
+    ENABLE_AGENT,
+    SET_MANAGER,
+    RENAME_PROJECT,
+    SET_PROJECT_ENABLED,
+}
+
+internal data class ProjectUpdateV58(
+    val projectId: String,
+    val baseVersion: Long,
+    val newVersion: Long,
+    val op: ProjectUpdateOpV58,
+    val agentId: String? = null,
+    val chatTitle: String? = null,
+    val role: String = "",
+    val description: String = "",
+    val displayName: String? = null,
+    val enabled: Boolean? = null,
+    val rawBlock: String,
+)
+
+internal data class RouteTaskV58(
+    val explicitProjectId: String?,
+    val routeId: String,
+    val fromRaw: String?,
+    val targetRaw: String,
+    val returnToRaw: String?,
+    val originalBlock: String,
+)
+
+internal object ProjectOrchestratorProtocolV58 {
+    private val projectIdPattern = Regex("^[A-Za-z0-9._-]{1,64}$")
+    private val agentIdPattern = Regex("^[A-Za-z0-9._-]{1,64}$")
+    private val routeIdPattern = Regex("^[A-Za-z0-9._:-]{1,160}$")
+
+    // Protocol sentinels must occupy their own lines. This prevents prose such as
+    // "the text ROUTE_TASK ..." or quoted markdown lines ("> ROUTE_TASK") from
+    // becoming executable control data while preserving existing SMT blocks.
+    private val manifestRegex = Regex(
+        "^[\t ]*PROJECT_MANIFEST[\t ]*$.*?^[\t ]*END_PROJECT_MANIFEST[\t ]*$",
+        setOf(RegexOption.DOT_MATCHES_ALL, RegexOption.MULTILINE, RegexOption.IGNORE_CASE),
+    )
+    private val updateRegex = Regex(
+        "^[\t ]*PROJECT_UPDATE[\t ]*$.*?^[\t ]*END_PROJECT_UPDATE[\t ]*$",
+        setOf(RegexOption.DOT_MATCHES_ALL, RegexOption.MULTILINE, RegexOption.IGNORE_CASE),
+    )
+    private val routeRegex = Regex(
+        "^[\t ]*ROUTE_TASK[\t ]*$.*?^[\t ]*END_ROUTE_TASK[\t ]*$",
+        setOf(RegexOption.DOT_MATCHES_ALL, RegexOption.MULTILINE, RegexOption.IGNORE_CASE),
+    )
+    private val resultEnvelopeRegex = Regex(
+        "^[\t ]*RESULT_FROM_AGENT[\t ]*$.*?^[\t ]*END_RESULT_FROM_AGENT[\t ]*$",
+        setOf(RegexOption.DOT_MATCHES_ALL, RegexOption.MULTILINE, RegexOption.IGNORE_CASE),
