-        for (
-            match in
-            matches.asReversed()
-        ) {
-            val block =
-                match.value.trim()
-
-            val routeId =
-                routeIdRegex
-                    .find(block)
-                    ?.groupValues
-                    ?.getOrNull(1)
-                    ?.trim()
-                    ?: continue
-
-            val targetLine =
-                targetRegex
