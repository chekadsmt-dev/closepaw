+    @Synchronized
+    fun applyManifest(manifest: ProjectManifestV58): Boolean {
+        val db = writableDatabase
+        val hash = ProjectOrchestratorProtocolV58.sha256(manifest.rawBlock)
+        db.beginTransaction()
+        try {
+            if (controlAlreadyApplied(db, manifest.projectId, hash)) {
+                db.setTransactionSuccessful()
+                return false
+            }
+            val current = projectInDb(db, manifest.projectId)
+            val oldManagerChat = current?.let { agentInDb(db, manifest.projectId, it.managerAgentId)?.chatTitle }
+            if (current != null) {
+                require(manifest.version > current.version) {
+                    "Manifest version ${manifest.version} must be greater than current ${current.version}"
+                }
+            }
+            require(manifest.agents.any { it.agentId == manifest.managerAgentId }) {
+                "Manager agent ${manifest.managerAgentId} must be included in manifest"
+            }
+            val now = System.currentTimeMillis()
+            val projectValues = ContentValues().apply {
+                put("project_id", manifest.projectId)
+                put("display_name", manifest.displayName)
+                put("manager_agent_id", manifest.managerAgentId)
+                put("version", manifest.version)
+                put("enabled", 1)
+                put("config_hash", hash)
+                put("updated_at", now)
+            }
+            db.insertWithOnConflict("projects", null, projectValues, SQLiteDatabase.CONFLICT_REPLACE)
+
+            // PROJECT_MANIFEST is an authoritative topology snapshot, not an additive patch.
+            // Agents omitted from a newer manifest are disabled rather than silently kept alive.
+            // Historical routes retain their snapshotted chat bindings and can still reconcile
+            // already-attempted delivery without mutating the new registry.
+            val manifestAgentIds = manifest.agents.map { it.agentId }.toSet()
+            allAgentIdsInDb(db, manifest.projectId)
+                .filterNot { it in manifestAgentIds }
+                .forEach { omitted -> setAgentEnabled(db, manifest.projectId, omitted, false, now) }
+
+            manifest.agents.forEach { agent ->
+                upsertAgentInDb(db, manifest.projectId, agent, enabled = true, now = now)
+            }
+            val newManagerChat = manifest.agents.single { it.agentId == manifest.managerAgentId }.chatTitle
+            val managerBoundaryChanged =
+                current == null ||
+                    !current.enabled ||
+                    current.managerAgentId != manifest.managerAgentId ||
+                    oldManagerChat != newManagerChat
+            if (managerBoundaryChanged) clearManagerResponseCursorInDb(db, manifest.projectId)
+            recordControl(db, manifest.projectId, hash, "MANIFEST", now)
+            db.setTransactionSuccessful()
+            return true
+        } finally {
+            db.endTransaction()
+        }
+    }
