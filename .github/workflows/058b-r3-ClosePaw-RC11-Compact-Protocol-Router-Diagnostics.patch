--- /dev/null
+++ b/app/src/main/kotlin/ai/closepaw/app/ChatGptProjectAdapterV58.kt
@@ -0,0 +1,583 @@
+package ai.closepaw.app
+
+import android.content.ClipData
+import android.content.ClipboardManager
+import android.content.Context
+import android.content.Intent
+import android.os.Build
+import android.os.Bundle
+import android.os.SystemClock
+import android.view.accessibility.AccessibilityNodeInfo
+import android.view.accessibility.AccessibilityWindowInfo
+import kotlinx.coroutines.delay
+
+
+internal data class AssistantResponseScanV58(
+    val responsesOldestFirst: List<String>,
+    val boundaryFound: Boolean,
+    val historyLimitReached: Boolean,
+)
+
+/**
+ * V58 ChatGPT Android adapter.
+ *
+ * Safety properties:
+ * - application-window/package binding is exact;
+ * - chat titles are exact, never substring/fuzzy matched;
+ * - Search and message composer are different semantic roles;
+ * - Send is resolved near the unique composer; no coordinate fallback;
+ * - every operation resolves fresh AccessibilityNodeInfo objects.
+ */
+internal class ChatGptProjectAdapterV58(private val service: AgentService) {
+    companion object {
+        private const val CHATGPT_PACKAGE = "com.openai.chatgpt"
+        private const val SETTLE_MS = 550L
+        private val NAV_LABELS = setOf("Open navigation drawer", "Navigation menu", "Open sidebar", "Sidebar", "Menu")
+        private val SEARCH_LABELS = setOf("Search chats", "Search conversations", "Search")
+        private val SEND_LABELS = setOf("Send message", "Send")
+        private val COPY_RESPONSE_LABELS = setOf("Copy response")
+        private val STOP_GENERATION_LABELS = setOf("Stop generating", "Stop response")
+        private val CHROME_LABELS = setOf(
+            "Copy response", "Share", "Read aloud", "Good response", "Bad response", "Regenerate", "Retry",
+            "Edit", "Send", "Send message", "Ask anything", "ChatGPT can make mistakes.", "Stop generating", "Stop response",
+        )
+    }
+
+    suspend fun launch() {
+        if (focusedRootOrNull() != null) return
+        val intent = service.packageManager.getLaunchIntentForPackage(CHATGPT_PACKAGE)
+            ?: error("ChatGPT app is not installed")
+        intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+        service.startActivity(intent)
+        repeat(12) {
+            delay(250)
+            if (focusedRootOrNull() != null) return
+        }
+        error("ChatGPT did not become the focused application surface")
+    }
+
+    suspend fun openConversation(exactTitle: String) {
+        require(exactTitle.isNotBlank())
+        launch()
+
+        val openedNavigation = clickUniqueExactLabel(NAV_LABELS)
+        if (openedNavigation) delay(SETTLE_MS)
+
+        // Never infer that the sidebar is open merely because the navigation button is absent.
+        // Require positive navigation-surface evidence before resolving an exact chat title.
+        val navigationSurfaceProven = openedNavigation || collectExactLabelNodes(SEARCH_LABELS).isNotEmpty()
+        if (!navigationSurfaceProven) {
+            error("ChatGPT navigation surface could not be proven")
+        }
+
+        if (clickUniqueExactText(exactTitle)) {
+            delay(SETTLE_MS)
+            requireUniqueComposer()
+            return
+        }
+
+        if (!clickUniqueExactLabel(SEARCH_LABELS)) {
+            error("Conversation '$exactTitle' not visible and Search chats is not uniquely grounded")
+        }
+        delay(300)
+        setTextInRole(EditRole.SEARCH, exactTitle)
+        delay(700)
+
+        if (!clickUniqueExactText(exactTitle)) {
+            error("Conversation not found by exact title: $exactTitle")
+        }
+        delay(SETTLE_MS)
+        requireUniqueComposer()
+    }
+
+    fun assistantResponseControlCount(): Int = collectExactLabelNodes(COPY_RESPONSE_LABELS).size
+
+    fun assistantMessageFingerprints(): List<String> =
+        assistantMessageTexts().map(ProjectOrchestratorProtocolV58::sha256)
+
+    fun assistantMessageTexts(): List<String> {
+        val root = focusedRootOrNull() ?: return emptyList()
+        val copyControls = mutableListOf<AccessibilityNodeInfo>()
+        walk(root) { node ->
+            if (nodeMatchesExactLabel(node, COPY_RESPONSE_LABELS)) copyControls += node
+        }
+        return copyControls.sortedBy(::nodeTop).mapNotNull(::messageTextForCopyControl).filter { it.isNotBlank() }
+    }
+
+    suspend fun latestAssistantResponse(): String? = copyVisibleAssistantResponseFromBottom(0)
+
+    /**
+     * Copy the exact assistant response whose accessibility-local message container
+     * contains [marker]. The accessibility association is only candidate selection;
+     * the copied clipboard payload must independently contain the same marker before
+     * it is accepted. This avoids accidentally copying a newer unrelated assistant
+     * turn when the correlated specialist response is no longer bottom-most.
+     */
+    suspend fun copyAssistantResponseContaining(
+        marker: String,
+        maxBackwardScrolls: Int = 2,
+    ): String? {
+        require(marker.isNotBlank())
+        try {
+            repeat(maxBackwardScrolls + 1) { pass ->
+                val controls = collectExactLabelNodes(COPY_RESPONSE_LABELS).sortedBy(::nodeTop)
+                for (control in controls.asReversed()) {
+                    val candidate = messageTextForCopyControl(control) ?: continue
+                    if (!candidate.contains(marker)) continue
+                    val copied = copyResponseControl(control)?.trim()
+                    if (!copied.isNullOrBlank() && copied.contains(marker)) return copied
+                }
+                if (pass >= maxBackwardScrolls) return@repeat
+                if (!scrollConversation(forward = false)) return@repeat
+                delay(250)
+            }
+            return null
+        } finally {
+            scrollToBottom(maxBackwardScrolls + 3)
+        }
+    }
+
+    /**
+     * Copies exact assistant responses newer than [cursorHash], oldest first.
+     *
+     * The cursor is the SHA-256 of bytes previously obtained through ChatGPT's
+     * Copy response action.  Accessibility text is never promoted to command
+     * authority.  When [cursorHash] is null, the caller has explicitly primed
+     * against an empty manager conversation and the history start is the safe
+     * boundary.  If a non-null cursor cannot be found within bounded history,
+     * [boundaryFound] is false and callers must fail closed rather than skip a gap.
+     */
+    suspend fun copyAssistantResponsesAfter(
+        cursorHash: String?,
+        maxBackwardScrolls: Int = 8,
+        maxResponses: Int = 24,
+    ): AssistantResponseScanV58 {
+        val newestFirst = mutableListOf<String>()
+        val seenHashes = linkedSetOf<String>()
+        var scrolls = 0
+
+        try {
+            while (true) {
+                val visibleCount = collectExactLabelNodes(COPY_RESPONSE_LABELS).size
+                for (indexFromBottom in 0 until visibleCount) {
+                    val response = copyVisibleAssistantResponseFromBottom(indexFromBottom)
+                        ?.trim()
+                        ?.takeIf { it.isNotBlank() }
+                        ?: continue
+                    val hash = ProjectOrchestratorProtocolV58.sha256(response)
+                    if (hash == cursorHash) {
+                        return AssistantResponseScanV58(
+                            responsesOldestFirst = newestFirst.asReversed(),
+                            boundaryFound = true,
+                            historyLimitReached = false,
+                        )
+                    }
+                    if (seenHashes.add(hash)) newestFirst += response
+                    if (newestFirst.size >= maxResponses) {
+                        return AssistantResponseScanV58(
+                            responsesOldestFirst = emptyList(),
+                            boundaryFound = false,
+                            historyLimitReached = true,
+                        )
+                    }
+                }
+
+                val movedBackward = scrollConversation(forward = false)
+                if (!movedBackward) {
+                    // A null cursor is only used after an explicitly observed empty baseline,
+                    // so reaching the beginning of history proves the lower boundary.
+                    val boundaryFound = cursorHash == null
+                    return AssistantResponseScanV58(
+                        responsesOldestFirst = if (boundaryFound) newestFirst.asReversed() else emptyList(),
+                        boundaryFound = boundaryFound,
+                        historyLimitReached = false,
+                    )
+                }
+                scrolls++
+                if (scrolls > maxBackwardScrolls) {
+                    return AssistantResponseScanV58(
+                        responsesOldestFirst = emptyList(),
+                        boundaryFound = false,
+                        historyLimitReached = true,
+                    )
+                }
+                delay(250)
+            }
+        } finally {
+            // Manager scanning is observational. Restore the normal latest-message surface
+            // before any route execution takes physical UI ownership.
+            scrollToBottom(maxBackwardScrolls + 3)
+        }
+    }
+
+    fun isGenerating(): Boolean = collectExactLabelNodes(STOP_GENERATION_LABELS).isNotEmpty()
+
+    suspend fun prepareComposerText(text: String, marker: String) {
+        val before = uniqueEditable(EditRole.COMPOSER)
+            ?: error("ChatGPT message composer is missing or ambiguous")
+        val existing = before.text?.toString().orEmpty()
+        if (existing.isNotBlank()) {
+            // Resume before ATTEMPTED is safe only when the draft is provably ours.
+            // Never overwrite a human draft or unrelated text in the shared ChatGPT UI.
+            require(existing.contains(marker)) {
+                "Composer is occupied by unrelated text; refusing to overwrite user draft"
+            }
+            require(existing == text) {
+                "Composer contains the route marker but does not match the prepared payload"
+            }
+        } else {
+            setTextInRole(EditRole.COMPOSER, text)
+            delay(220)
+        }
+        val composer = uniqueEditable(EditRole.COMPOSER) ?: error("Composer disappeared after SET_TEXT")
+        val value = composer.text?.toString().orEmpty()
+        require(value.contains(marker) && value == text) {
+            "Composer SET_TEXT could not be verified against exact prepared payload"
+        }
+    }
+
+    fun sendPreparedMessage(): Boolean {
+        val composer = uniqueEditable(EditRole.COMPOSER) ?: return false
+        val send = uniqueActionNearComposer(composer, SEND_LABELS) ?: return false
+        return clickNodeOrParent(send)
+    }
+
+    suspend fun outgoingMarkerVisible(marker: String, maxBackwardScrolls: Int = 0): Boolean {
+        repeat(maxBackwardScrolls + 1) { pass ->
+            if (nonEditableVisibleTextContains(marker)) {
+                if (pass > 0) scrollToBottom(maxBackwardScrolls + 2)
+                return true
+            }
+            if (pass < maxBackwardScrolls && !scrollConversation(forward = false)) return@repeat
+            if (pass < maxBackwardScrolls) delay(250)
+        }
+        scrollToBottom(maxBackwardScrolls + 2)
+        return false
+    }
+
+    suspend fun scrollToBottom(maxScrolls: Int = 12) {
+        repeat(maxScrolls) {
+            if (!scrollConversation(forward = true)) return
+            delay(90)
+        }
+    }
+
+    fun screenText(): String = visibleLines().joinToString("\n")
+
+    private enum class EditRole { SEARCH, COMPOSER }
+
+    private fun focusedRootOrNull(): AccessibilityNodeInfo? {
+        val windows = service.windows.orEmpty()
+        val candidates = windows.filter { window ->
+            window.type == AccessibilityWindowInfo.TYPE_APPLICATION &&
+                (window.isActive || window.isFocused) &&
+                window.root?.packageName?.toString() == CHATGPT_PACKAGE
+        }
+        if (candidates.size == 1) return candidates.single().root
+        if (candidates.size > 1) {
+            val focused = candidates.filter { it.isFocused }
+            if (focused.size == 1) return focused.single().root
+            return null
+        }
+        val active = service.rootInActiveWindow
+        return active?.takeIf { it.packageName?.toString() == CHATGPT_PACKAGE }
+    }
+
+    private fun requireUniqueComposer(): AccessibilityNodeInfo =
+        uniqueEditable(EditRole.COMPOSER) ?: error("ChatGPT message composer is missing or ambiguous")
+
+    private fun setTextInRole(role: EditRole, text: String) {
+        val target = uniqueEditable(role) ?: error("ChatGPT ${role.name.lowercase()} field is missing or ambiguous")
+        val args = Bundle().apply {
+            putCharSequence(AccessibilityNodeInfo.ACTION_ARGUMENT_SET_TEXT_CHARSEQUENCE, text)
+        }
+        require(target.performAction(AccessibilityNodeInfo.ACTION_SET_TEXT, args)) {
+            "ACTION_SET_TEXT failed for ${role.name.lowercase()}"
+        }
+    }
+
+    private fun uniqueEditable(role: EditRole): AccessibilityNodeInfo? {
+        val root = focusedRootOrNull() ?: return null
+        val all = mutableListOf<AccessibilityNodeInfo>()
+        walk(root) { node ->
+            if (node.packageName?.toString() == CHATGPT_PACKAGE && node.isVisibleToUser && node.isEnabled &&
+                (node.isEditable || node.className?.toString()?.contains("EditText") == true)
+            ) all += node
+        }
+        val roleMatches = all.filter { node ->
+            val semantic = listOfNotNull(node.hintText, node.contentDescription, node.text)
+                .joinToString(" ") { it.toString() }
+            val search = semantic.contains("search", ignoreCase = true)
+            when (role) {
+                EditRole.SEARCH -> search
+                EditRole.COMPOSER -> !search && (
+                    semantic.contains("message", ignoreCase = true) ||
+                        semantic.contains("ask", ignoreCase = true) ||
+                        semantic.contains("chatgpt", ignoreCase = true)
+                    )
+            }
+        }
+        if (roleMatches.size == 1) return roleMatches.single()
+        // Conservative role fallback: only when the surface has exactly one editable and it cannot be Search.
+        if (role == EditRole.COMPOSER && all.size == 1) {
+            val semantic = listOfNotNull(all.single().hintText, all.single().contentDescription, all.single().text)
+                .joinToString(" ") { it.toString() }
+            if (!semantic.contains("search", ignoreCase = true)) return all.single()
+        }
+        return null
+    }
+
+    private fun uniqueActionNearComposer(
+        composer: AccessibilityNodeInfo,
+        labels: Set<String>,
+    ): AccessibilityNodeInfo? {
+        var ancestor: AccessibilityNodeInfo? = composer
+        repeat(6) {
+            ancestor = ancestor?.parent
+            val scope = ancestor ?: return null
+            val candidates = mutableListOf<AccessibilityNodeInfo>()
+            walk(scope) { node ->
+                if (node.packageName?.toString() == CHATGPT_PACKAGE && node.isVisibleToUser && node.isEnabled &&
+                    nodeMatchesExactLabel(node, labels)
+                ) {
+                    nearestClickable(node)?.let { clickable ->
+                        if (candidates.none { it == clickable }) candidates += clickable
+                    }
+                }
+            }
+            if (candidates.size == 1) return candidates.single()
+            if (candidates.size > 1) return null
+        }
+        return null
+    }
+
+    private fun clickUniqueExactText(text: String): Boolean {
+        val root = focusedRootOrNull() ?: return false
+        val clickTargets = mutableListOf<AccessibilityNodeInfo>()
+        walk(root) { node ->
+            val exact = node.text?.toString()?.trim() == text || node.contentDescription?.toString()?.trim() == text
+            if (exact && node.isVisibleToUser && node.isEnabled && !node.isEditable && !hasEditableAncestor(node)) {
+                nearestClickable(node)?.let { target ->
+                    if (clickTargets.none { it == target }) clickTargets += target
+                }
+            }
+        }
+        return clickTargets.singleOrNull()?.let(::clickNodeOrParent) == true
+    }
+
+    private fun clickUniqueExactLabel(labels: Set<String>): Boolean {
+        val nodes = collectExactLabelNodes(labels)
+        val targets = nodes.mapNotNull(::nearestClickable).distinctBy { nodeSignature(it) }
+        return targets.singleOrNull()?.let(::clickNodeOrParent) == true
+    }
+
+    private fun collectExactLabelNodes(labels: Set<String>): List<AccessibilityNodeInfo> {
+        val root = focusedRootOrNull() ?: return emptyList()
+        val out = mutableListOf<AccessibilityNodeInfo>()
+        walk(root) { if (nodeMatchesExactLabel(it, labels)) out += it }
+        return out
+    }
+
+    private fun nodeMatchesExactLabel(node: AccessibilityNodeInfo, labels: Set<String>): Boolean {
+        val values = listOfNotNull(node.text?.toString()?.trim(), node.contentDescription?.toString()?.trim())
+        return values.any { value -> labels.any { label -> value.equals(label, ignoreCase = true) } }
+    }
+
+    private fun nearestClickable(node: AccessibilityNodeInfo): AccessibilityNodeInfo? {
+        var current: AccessibilityNodeInfo? = node
+        repeat(6) {
+            val n = current ?: return null
+            if (n.isVisibleToUser && n.isEnabled && n.isClickable &&
+                n.actionList.any { it.id == AccessibilityNodeInfo.ACTION_CLICK }
+            ) return n
+            current = n.parent
+        }
+        return null
+    }
+
+    private fun clickNodeOrParent(node: AccessibilityNodeInfo): Boolean =
+        nearestClickable(node)?.performAction(AccessibilityNodeInfo.ACTION_CLICK) == true
+
+    private fun nonEditableVisibleTextContains(marker: String): Boolean {
+        val root = focusedRootOrNull() ?: return false
+        var found = false
+        walk(root) { node ->
+            if (found || !node.isVisibleToUser || node.isEditable || hasEditableAncestor(node)) return@walk
+            val values = listOfNotNull(node.text?.toString(), node.contentDescription?.toString())
+            if (values.any { it.contains(marker) }) found = true
+        }
+        return found
+    }
+
+    private fun hasEditableAncestor(node: AccessibilityNodeInfo): Boolean {
+        var current = node.parent
+        repeat(4) {
+            val n = current ?: return false
+            if (n.isEditable) return true
+            current = n.parent
+        }
+        return false
+    }
+
+    private fun messageTextForCopyControl(copy: AccessibilityNodeInfo): String? {
+        var current = copy.parent
+        repeat(8) {
+            val candidate = current ?: return null
+            if (countCopyResponseControls(candidate, limit = 2) == 1 && !containsEditableDescendant(candidate)) {
+                val lines = contentLines(candidate)
+                if (lines.isNotEmpty()) return lines.joinToString("\n")
+            }
+            current = candidate.parent
+        }
+        return null
+    }
+
+    private fun containsEditableDescendant(root: AccessibilityNodeInfo): Boolean {
+        var found = false
+        fun visit(node: AccessibilityNodeInfo) {
+            if (found) return
+            if (node.isEditable) {
+                found = true
+                return
+            }
+            for (i in 0 until node.childCount) node.getChild(i)?.let(::visit)
+        }
+        visit(root)
+        return found
+    }
+
+    private fun countCopyResponseControls(root: AccessibilityNodeInfo, limit: Int): Int {
+        var count = 0
+        fun visit(node: AccessibilityNodeInfo) {
+            if (count >= limit) return
+            if (nodeMatchesExactLabel(node, COPY_RESPONSE_LABELS)) count++
+            for (i in 0 until node.childCount) node.getChild(i)?.let(::visit)
+        }
+        visit(root)
+        return count
+    }
+
+    private fun contentLines(root: AccessibilityNodeInfo): List<String> {
+        val lines = mutableListOf<String>()
+        walk(root) { node ->
+            if (!node.isVisibleToUser) return@walk
+            listOfNotNull(node.text?.toString(), node.contentDescription?.toString()).forEach { raw ->
+                val value = raw.trim()
+                if (value.isBlank()) return@forEach
+                if (CHROME_LABELS.any { value.equals(it, ignoreCase = true) }) return@forEach
+                if (lines.lastOrNull() != value) lines += value
+            }
+        }
+        return lines
+    }
+
+    private fun visibleLines(): List<String> {
+        val root = focusedRootOrNull() ?: return emptyList()
+        val lines = mutableListOf<String>()
+        walk(root) { node ->
+            if (!node.isVisibleToUser) return@walk
+            listOfNotNull(node.text?.toString(), node.contentDescription?.toString()).forEach { raw ->
+                val value = raw.trim()
+                if (value.isNotBlank() && lines.lastOrNull() != value) lines += value
+            }
+        }
+        return lines
+    }
+
+    private fun scrollConversation(forward: Boolean): Boolean {
+        val root = focusedRootOrNull() ?: return false
+        val action = if (forward) AccessibilityNodeInfo.ACTION_SCROLL_FORWARD else AccessibilityNodeInfo.ACTION_SCROLL_BACKWARD
+        val candidates = mutableListOf<AccessibilityNodeInfo>()
+        walk(root) { node ->
+            if (node.isVisibleToUser && node.isEnabled && node.isScrollable && node.actionList.any { it.id == action }) {
+                candidates += node
+            }
+        }
+        // Prefer the largest scrollable application surface. ChatGPT responses live in the
+        // main conversation list; nested code blocks/carousels are smaller and must not steal
+        // reconciliation/history scrolling merely because they appear later in tree order.
+        return candidates
+            .sortedByDescending(::nodeArea)
+            .firstOrNull { it.performAction(action) } != null
+    }
+
+    private suspend fun copyVisibleAssistantResponseFromBottom(indexFromBottom: Int): String? {
+        if (indexFromBottom < 0) return null
+        // Re-resolve on every copy. Copy actions and Android toasts can invalidate old nodes.
+        val controls = collectExactLabelNodes(COPY_RESPONSE_LABELS).sortedBy(::nodeTop)
+        val index = controls.lastIndex - indexFromBottom
+        if (index !in controls.indices) return null
+        return copyResponseControl(controls[index])
+    }
+
+    private suspend fun copyResponseControl(control: AccessibilityNodeInfo): String? {
+        val clipboard = service.getSystemService(Context.CLIPBOARD_SERVICE) as ClipboardManager
+        val hadOriginal = clipboard.hasPrimaryClip()
+        val original = clipboard.primaryClip
+        val sentinel = "__CLOSEPAW_V58_COPY_${SystemClock.elapsedRealtimeNanos()}__"
+        var captured: String? = null
+        try {
+            clipboard.setPrimaryClip(ClipData.newPlainText("ClosePaw copy probe", sentinel))
+            if (!clickNodeOrParent(control)) return null
+            // Positive copy receipt: the clipboard must move away from our unique sentinel.
+            // This remains valid even when the user happened to have copied the same assistant
+            // response previously, unlike a simple before/after string comparison.
+            repeat(10) {
+                delay(100)
+                val after = clipboardText()?.trim()
+                if (!after.isNullOrBlank() && after != sentinel) {
+                    captured = after
+                    return after
+                }
+            }
+            return null
+        } finally {
+            // Copy is an internal transport primitive, not a user-requested clipboard mutation.
+            // Restore the previous clipboard only if nobody else changed it after our probe/copy.
+            val current = clipboardText()?.trim()
+            if (current == sentinel || (captured != null && current == captured)) {
+                if (hadOriginal && original != null) {
+                    clipboard.setPrimaryClip(original)
+                } else if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
+                    clipboard.clearPrimaryClip()
+                } else {
+                    clipboard.setPrimaryClip(ClipData.newPlainText("", ""))
+                }
+            }
+        }
+    }
+
+    private fun clipboardText(): String? = runCatching {
+        val clipboard = service.getSystemService(Context.CLIPBOARD_SERVICE) as ClipboardManager
+        val clip = clipboard.primaryClip ?: return@runCatching null
+        if (clip.itemCount == 0) return@runCatching null
+        clip.getItemAt(0).coerceToText(service)?.toString()
+    }.getOrNull()
+
+
+    private fun nodeArea(node: AccessibilityNodeInfo): Long {
+        val rect = android.graphics.Rect()
+        node.getBoundsInScreen(rect)
+        return rect.width().toLong().coerceAtLeast(0L) * rect.height().toLong().coerceAtLeast(0L)
+    }
+
+    private fun nodeTop(node: AccessibilityNodeInfo): Int {
+        val rect = android.graphics.Rect()
+        node.getBoundsInScreen(rect)
+        return rect.top
+    }
+
+    private fun nodeSignature(node: AccessibilityNodeInfo): String = buildString {
+        append(node.windowId).append('|')
+        append(node.className).append('|')
+        append(node.viewIdResourceName).append('|')
+        val rect = android.graphics.Rect()
+        node.getBoundsInScreen(rect)
+        append(rect.flattenToString())
+    }
+
+    private fun walk(node: AccessibilityNodeInfo, visitor: (AccessibilityNodeInfo) -> Unit) {
+        visitor(node)
+        for (i in 0 until node.childCount) node.getChild(i)?.let { walk(it, visitor) }
+    }
+}
