diff --git a/app/src/main/kotlin/ai/closepaw/app/PostPlanGuardV58A.kt b/app/src/main/kotlin/ai/closepaw/app/PostPlanGuardV58A.kt
new file mode 100644
index 0000000..0b01b4e
--- /dev/null
+++ b/app/src/main/kotlin/ai/closepaw/app/PostPlanGuardV58A.kt
@@ -0,0 +1,40 @@
+package ai.closepaw.app
+
+import kotlinx.coroutines.TimeoutCancellationException
+import kotlinx.coroutines.withTimeout
+
+/**
+ * Hard boundary between an accepted model plan and the RC11 action transaction.
+ *
+ * 057a already bounds the transaction itself, but c058 device diagnostics proved that work can
+ * still suspend indefinitely *before* `executeActionTransactionV9()` while re-checking local goal
+ * completion / refreshing the plan lease. This guard closes that gap without changing ATTEMPTED,
+ * replay, or transaction semantics.
+ */
+internal object PostPlanGuardV58A {
+    const val DEADLINE_MS: Long = 15_000L
+
+    suspend fun <T> run(
+        timeoutMs: Long = DEADLINE_MS,
+        block: suspend () -> T,
+    ): T {
+        require(timeoutMs > 0L)
+        return try {
+            withTimeout(timeoutMs) { block() }
+        } catch (timeout: TimeoutCancellationException) {
+            // A cancelled owner must still be classified as owner/user cancellation. If the owner
+            // remains active, this is a bounded pre-dispatch operation timeout and is safe to
+            // re-observe/replan because no ATTEMPTED record exists yet.
+            rethrowOwnerCancellationV57(timeout)
+            throw PostPlanGateTimeoutV58AException(timeoutMs, timeout)
+        }
+    }
+}
+
+internal class PostPlanGateTimeoutV58AException(
+    val timeoutMs: Long,
+    cause: Throwable? = null,
+) : IllegalStateException(
+    "POST_PLAN_GATE_TIMEOUT_V58A: attempted=false timeoutMs=$timeoutMs",
+    cause,
+)
