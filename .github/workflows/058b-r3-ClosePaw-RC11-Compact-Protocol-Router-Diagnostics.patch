+    private fun tableExists(db: SQLiteDatabase, table: String): Boolean =
+        db.rawQuery("SELECT name FROM sqlite_master WHERE type='table' AND name=?", arrayOf(table)).use { it.moveToFirst() }
+
+    private fun projectCount(db: SQLiteDatabase): Long =
+        db.rawQuery("SELECT COUNT(*) FROM projects", null).use { c -> c.moveToFirst(); c.getLong(0) }
