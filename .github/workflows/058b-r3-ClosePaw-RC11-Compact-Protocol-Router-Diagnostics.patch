+    @Synchronized
+    fun registrySummary(): String {
+        val projects = enabledProjects()
+        val agents = projects.sumOf { enabledAgents(it.projectId).size }
+        val routes = readableDatabase.rawQuery("SELECT COUNT(*) FROM routes", null).use { c -> c.moveToFirst(); c.getLong(0) }
+        val pending = runnableRoutes(10_000).size
+        return "projects=${projects.size}, agents=$agents, routes=$routes, pending=$pending"
+    }
