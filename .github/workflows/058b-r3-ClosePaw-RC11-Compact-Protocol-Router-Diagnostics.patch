+
+/**
+ * Generic runtime project orchestrator.
+ *
+ * Project topology is data in [ProjectOrchestratorStoreV58], not Kotlin routing code.
+ * SMT is only a migration seed. New projects/agents and topology changes are applied at runtime.
+ */
+internal class ProjectOrchestratorV58(private val service: AgentService) {
+    companion object {
+        private const val TAG = "ProjectRouterV58"
+        private const val IDLE_POLL_MS = 2_500L
+        private const val MANAGER_SCAN_INTERVAL_MS = 12_000L
+        private const val RESPONSE_CHECK_WINDOW_MS = 10_000L
+        private const val RESPONSE_POLL_MS = 850L
+        private const val UI_CLICK_VERIFY_MS = 800L
+        private const val WORKER_RESTART_BACKOFF_MS = 5_000L
+        private const val CONTROL_PLANE_MARKER = "CONTROL_PLANE: CLOSEPAW_V58"
+
+        fun isControlCommand(text: String): Boolean = ProjectOrchestratorProtocolV58.isControlInput(text)
+    }
+
+    private val store = ProjectOrchestratorStoreV58(service)
+    private val ui = ChatGptProjectAdapterV58(service)
+    private val ownerLock = Any()
+    private val directControlMutex = Mutex()
+    @Volatile private var workerJob: Job? = null
+    private val managerScanAtByProject = mutableMapOf<String, Long>()
+
+    val isRunning: Boolean
+        get() = workerJob != null
+
+    fun handleControlInput(text: String): Boolean {
+        if (!isControlCommand(text)) return false
+        store.initialize()
+        val trimmed = text.trim()
+        when {
+            trimmed.equals("ROUTER START", true) ||
+                trimmed.equals("ROUTER ON", true) ||
+                trimmed.equals("PROJECT ROUTER START", true) ||
+                trimmed.equals("PROJECT ROUTER ON", true) ||
+                trimmed.equals("SMT ROUTER START", true) ||
+                trimmed.equals("SMT ROUTER ON", true) -> {
+                store.setRouterEnabled(true)
+                start()
+                service.publishHybridStatus("Project Router V58 running — ${store.registrySummary()}")
+            }
+            trimmed.equals("ROUTER STOP", true) ||
+                trimmed.equals("ROUTER OFF", true) ||
+                trimmed.equals("PROJECT ROUTER STOP", true) ||
+                trimmed.equals("PROJECT ROUTER OFF", true) ||
+                trimmed.equals("SMT ROUTER STOP", true) ||
+                trimmed.equals("SMT ROUTER OFF", true) -> {
+                store.setRouterEnabled(false)
+                stop("control_command")
+                service.publishHybridStatus("Project Router V58 stopping")
+            }
+            trimmed.equals("ROUTER STATUS", true) || trimmed.equals("PROJECT ROUTER STATUS", true) -> {
+                service.publishHybridStatus("Project Router V58 ${if (isRunning) "running" else "stopped"} — ${store.registrySummary()}")
+            }
+            else -> {
+                val manifests = ProjectOrchestratorProtocolV58.manifests(trimmed)
+                val updates = ProjectOrchestratorProtocolV58.updates(trimmed)
+                require(manifests.size + updates.size == 1) { "Control input must contain exactly one PROJECT_MANIFEST or PROJECT_UPDATE" }
+                if (isRunning) {
+                    // Direct runtime topology mutation must not interleave with a suspended
+                    // manager scan/UI transaction. Pause the single physical owner, mutate the
+                    // versioned registry, then restore durable router enablement.
+                    service.publishHybridStatus("Project Router V58 pausing for topology update")
+                    service.serviceScope.launch {
+                        directControlMutex.withLock {
+                            val resume = store.isRouterEnabled()
+                            try {
+                                pauseAndJoin("direct_topology_update")
+                                applyTopologyControl(manifests.singleOrNull(), updates.singleOrNull())
+                            } catch (cancel: CancellationException) {
+                                throw cancel
+                            } catch (t: Throwable) {
+                                trace("DIRECT_CONTROL_ERROR", t.message.orEmpty())
+                                service.publishHybridStatus("Project topology update failed: ${t.message}")
+                            } finally {
+                                if (resume && store.isRouterEnabled() && currentCoroutineContext().isActive) start()
+                            }
+                        }
+                    }
+                } else {
+                    applyTopologyControl(manifests.singleOrNull(), updates.singleOrNull())
+                }
+            }
+        }
+        return true
+    }
+
+    private fun applyTopologyControl(manifest: ProjectManifestV58?, update: ProjectUpdateV58?) {
+        require((manifest != null) xor (update != null)) { "Exactly one topology control is required" }
+        if (manifest != null) {
+            val changed = store.applyManifest(manifest)
+            service.publishHybridStatus(
+                "Project manifest ${if (changed) "applied" else "already applied"}: ${manifest.projectId} v${manifest.version}"
+            )
+        } else {
+            val command = requireNotNull(update)
+            val changed = store.applyUpdate(command)
+            service.publishHybridStatus(
+                "Project update ${if (changed) "applied" else "already applied"}: ${command.projectId} v${command.newVersion}"
+            )
+        }
+    }
+
+    fun resumeIfEnabled() {
+        store.initialize()
+        if (store.isRouterEnabled()) start()
+    }
+
+    fun disableAndStop(source: String) {
+        store.initialize()
+        store.setRouterEnabled(false)
+        stop(source)
+    }
+
+    fun start() {
+        store.initialize()
+        synchronized(ownerLock) {
+            if (workerJob != null) return
+            val launched = service.serviceScope.launch {
+                try {
+                    trace("WORKER_START", "registry=${store.registrySummary()}")
+                    while (currentCoroutineContext().isActive && store.isRouterEnabled()) {
+                        try {
+                            mainLoop()
+                        } catch (cancel: CancellationException) {
+                            throw cancel
+                        } catch (t: Throwable) {
+                            // Durable router enablement must survive transient ChatGPT/UI failure.
+                            // Keep the single owner, back off, then re-enter from durable SQLite state.
+                            trace("WORKER_ITERATION_ERROR", t.message.orEmpty())
+                            Log.e(TAG, "Project orchestrator iteration failed; retrying", t)
+                            service.publishHybridStatus("Project Router V58 retrying after error: ${t.message}")
+                            delay(WORKER_RESTART_BACKOFF_MS)
+                        }
+                    }
+                } catch (cancel: CancellationException) {
+                    trace("WORKER_CANCELLED", cancel.message.orEmpty())
+                    throw cancel
+                } finally {
+                    val owner = currentCoroutineContext()[Job]
+                    synchronized(ownerLock) {
+                        if (workerJob === owner) workerJob = null
+                    }
+                    trace("WORKER_COMPLETED", "")
+                }
+            }
+            workerJob = launched
+        }
+    }
+
+    fun stop(source: String = "ui") {
+        synchronized(ownerLock) {
+            val owner = workerJob ?: run {
+                trace("STOP_NO_OWNER", "source=$source")
+                return
+            }
+            trace("STOP_REQUESTED", "source=$source")
+            owner.cancel(CancellationException("Project Router stopped: $source"))
+            // Do not clear workerJob here. It is the owner barrier until finally completes.
+        }
+    }
+
+    suspend fun stopAndJoin(source: String) {
+        store.setRouterEnabled(false)
+        pauseAndJoin(source)
+    }
+
+    private suspend fun pauseAndJoin(source: String) {
+        val owner = synchronized(ownerLock) {
+            val current = workerJob
+            if (current != null) {
+                trace("STOP_REQUESTED", "source=$source|await=true|preserveEnabled=true")
+                current.cancel(CancellationException("Project Router paused: $source"))
+            }
+            current
+        }
+        owner?.join()
+    }
+
+    private suspend fun mainLoop() {
+        ui.launch()
+        while (currentCoroutineContext().isActive && store.isRouterEnabled()) {
+            currentCoroutineContext().ensureActive()
+            // Scan at most one due manager per loop. This keeps project discovery scalable
+            // and prevents N projects from monopolizing the one physical Android UI before
+            // an already-durable route gets a chance to advance.
+            scanOneDueManager()
+
+            var progressed = false
+            for (route in store.runnableRoutes(limit = 12)) {
+                currentCoroutineContext().ensureActive()
+                if (processOneStep(route)) {
+                    progressed = true
+                    break // one physical UI owner/action chain at a time
+                }
+            }
+            if (!progressed) delay(IDLE_POLL_MS)
+        }
+    }
+
+    private suspend fun scanOneDueManager() {
+        val now = System.currentTimeMillis()
+        val project = store.enabledProjects()
+            .filter { now - (managerScanAtByProject[it.projectId] ?: 0L) >= MANAGER_SCAN_INTERVAL_MS }
+            .minByOrNull { managerScanAtByProject[it.projectId] ?: 0L }
+            ?: return
+        managerScanAtByProject[project.projectId] = now
+        currentCoroutineContext().ensureActive()
+        val manager = store.agent(project.projectId, project.managerAgentId)
+            ?.takeIf { it.enabled }
+        if (manager == null) {
+            trace("MANAGER_INVALID", "project=${project.projectId} agent=${project.managerAgentId}")
+            return
+        }
+        try {
+                trace("MANAGER_SCAN_START", "project=${project.projectId} chat=${manager.chatTitle}")
+                ui.openConversation(manager.chatTitle)
