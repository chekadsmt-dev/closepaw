+
+    private data class ExactWholeResultV58<T>(
+        val hadSentinel: Boolean,
+        val parsed: List<T>,
+    )
+
+    /**
+     * Exact multiline protocol is executable only when the whole control surface is
+     * protocol blocks (plus whitespace). This rejects code fences, explanatory prose,
+     * and quoted examples instead of extracting executable commands from arbitrary text.
+     */
+    private fun <T> exactWholeBlocks(
+        text: String,
+        regex: Regex,
+        parser: (String) -> T?,
+    ): ExactWholeResultV58<T> {
+        val matches = regex.findAll(text).toList()
+        if (matches.isEmpty()) return ExactWholeResultV58(false, emptyList())
+        if (regex.replace(text, "").trim().isNotEmpty()) {
+            return ExactWholeResultV58(true, emptyList())
+        }
+        val parsed = matches.mapNotNull { parser(it.value) }
+        if (parsed.size != matches.size) return ExactWholeResultV58(true, emptyList())
+        return ExactWholeResultV58(true, parsed)
+    }
+
+    private data class CompactFieldsV58(
+        val block: String,
+        val values: Map<String, List<String>>,
+    ) {
+        fun one(key: String): String? = values[key.uppercase()]?.singleOrNull()
+        fun all(key: String): List<String> = values[key.uppercase()].orEmpty()
+        fun count(vararg keys: String): Int = keys.sumOf { values[it.uppercase()]?.size ?: 0 }
+    }
+
+    private fun compactBlocks(text: String, start: String, end: String): List<String> {
+        val compact = collapseTransportWhitespace(text)
+        if (compact.isBlank()) return emptyList()
+        val out = mutableListOf<String>()
+        var rest = compact.trim()
+        while (rest.isNotBlank()) {
+            if (!startsWithToken(rest, start)) return emptyList()
+            val endMatch = Regex("(?i)(?:^|\\s)${Regex.escape(end)}(?:\\s|$)").find(rest)
+                ?: return emptyList()
+            val blockEnd = endMatch.range.last + 1
+            val block = rest.substring(0, blockEnd).trim()
+            if (!endsWithToken(block, end)) return emptyList()
+            out += block
+            rest = rest.substring(blockEnd).trim()
+        }
+        return out
+    }
+
+    private fun parseCompactRoute(block: String): RouteTaskV58? {
+        val fields = parseCompactFields(
+            block = block,
+            start = "ROUTE_TASK",
+            end = "END_ROUTE_TASK",
+            keys = listOf(
+                "PROJECT_ID", "ROUTE_ID", "FROM_AGENT", "FROM", "TARGET_ID", "TARGET",
+                "OBJECTIVE", "CONTEXT", "REQUIRED_OUTPUT", "RETURN_TO",
+            ),
+            repeatableKeys = emptySet(),
+        ) ?: return null
+        if (fields.count("ROUTE_ID") != 1) return null
+        if (fields.count("TARGET_ID", "TARGET") != 1) return null
+        if (fields.count("PROJECT_ID") > 1 || fields.count("FROM_AGENT", "FROM") > 1 || fields.count("RETURN_TO") > 1) return null
+
+        val routeId = fields.one("ROUTE_ID") ?: return null
+        val target = fields.one("TARGET_ID") ?: fields.one("TARGET") ?: return null
+        val projectId = fields.one("PROJECT_ID")
+        if (!validRouteId(routeId) || (projectId != null && !validProjectId(projectId))) return null
+        return RouteTaskV58(
+            explicitProjectId = projectId,
+            routeId = routeId,
+            fromRaw = fields.one("FROM_AGENT") ?: fields.one("FROM"),
+            targetRaw = target,
+            returnToRaw = fields.one("RETURN_TO"),
+            originalBlock = fields.block,
+        )
+    }
+
+    private fun parseCompactUpdate(block: String): ProjectUpdateV58? {
+        val fields = parseCompactFields(
+            block = block,
+            start = "PROJECT_UPDATE",
+            end = "END_PROJECT_UPDATE",
+            keys = listOf(
+                "PROJECT_ID", "BASE_VERSION", "NEW_VERSION", "OP", "AGENT_ID", "CHAT_TITLE",
+                "ROLE", "DESCRIPTION", "DISPLAY_NAME", "ENABLED",
+            ),
+            repeatableKeys = emptySet(),
+        ) ?: return null
+        val projectId = fields.one("PROJECT_ID") ?: return null
+        val baseVersion = fields.one("BASE_VERSION")?.toLongOrNull() ?: return null
+        val newVersion = fields.one("NEW_VERSION")?.toLongOrNull() ?: return null
+        val op = fields.one("OP")?.uppercase()?.let { runCatching { ProjectUpdateOpV58.valueOf(it) }.getOrNull() }
+            ?: return null
+        if (!validProjectId(projectId) || baseVersion < 1L || newVersion != baseVersion + 1L) return null
+
+        val agentId = fields.one("AGENT_ID")
+        val chatTitle = fields.one("CHAT_TITLE")
+        val enabled = fields.one("ENABLED")?.let {
+            when (it.lowercase()) {
+                "true", "1", "yes", "on" -> true
+                "false", "0", "no", "off" -> false
+                else -> return null
+            }
+        }
+        when (op) {
+            ProjectUpdateOpV58.UPSERT_AGENT -> if (agentId == null || !validAgentId(agentId) || chatTitle.isNullOrBlank()) return null
+            ProjectUpdateOpV58.DISABLE_AGENT,
+            ProjectUpdateOpV58.ENABLE_AGENT,
+            ProjectUpdateOpV58.SET_MANAGER -> if (agentId == null || !validAgentId(agentId)) return null
+            ProjectUpdateOpV58.RENAME_PROJECT -> if (fields.one("DISPLAY_NAME").isNullOrBlank()) return null
+            ProjectUpdateOpV58.SET_PROJECT_ENABLED -> if (enabled == null) return null
+        }
+        return ProjectUpdateV58(
+            projectId = projectId,
+            baseVersion = baseVersion,
+            newVersion = newVersion,
+            op = op,
+            agentId = agentId,
+            chatTitle = chatTitle,
+            role = fields.one("ROLE").orEmpty(),
+            description = fields.one("DESCRIPTION").orEmpty(),
+            displayName = fields.one("DISPLAY_NAME"),
+            enabled = enabled,
+            rawBlock = fields.block,
