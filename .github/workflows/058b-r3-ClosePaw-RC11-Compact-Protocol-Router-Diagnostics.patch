+
+    private fun recordControl(db: SQLiteDatabase, projectId: String, hash: String, kind: String, now: Long) {
+        val values = ContentValues().apply {
+            put("project_id", projectId)
+            put("control_hash", hash)
+            put("control_kind", kind)
+            put("applied_at", now)
+        }
+        db.insertWithOnConflict("applied_controls", null, values, SQLiteDatabase.CONFLICT_IGNORE)
+    }
+
+    private fun allAgentIdsInDb(db: SQLiteDatabase, projectId: String): List<String> =
+        db.query(
+            "agents",
+            arrayOf("agent_id"),
+            "project_id = ?",
+            arrayOf(projectId),
+            null, null, "agent_id ASC",
+        ).use { c -> buildList { while (c.moveToNext()) add(c.getString(0)) } }
+
