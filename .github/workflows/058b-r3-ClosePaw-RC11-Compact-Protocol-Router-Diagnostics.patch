+    }
+
+    private fun putMetaInDb(db: SQLiteDatabase, key: String, value: String) {
+        val values = ContentValues().apply {
+            put("meta_key", key)
+            put("meta_value", value)
+        }
+        db.insertWithOnConflict("router_meta", null, values, SQLiteDatabase.CONFLICT_REPLACE)
+    }
+
+    private fun upsertAgentInDb(
+        db: SQLiteDatabase,
+        projectId: String,
+        spec: ProjectAgentSpecV58,
+        enabled: Boolean,
+        now: Long,
+    ) {
+        val collision = db.query(
+            "agents",
+            arrayOf("agent_id"),
+            "project_id = ? AND chat_title = ? AND agent_id <> ?",
+            arrayOf(projectId, spec.chatTitle, spec.agentId),
+            null, null, null, "1",
+        ).use { c -> if (c.moveToFirst()) c.getString(0) else null }
+        require(collision == null) { "Chat binding '${spec.chatTitle}' is already owned by agent $collision" }
