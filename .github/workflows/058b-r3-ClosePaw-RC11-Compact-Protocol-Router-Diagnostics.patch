+                            store.setManagerResponseCursor(project.projectId, managerResponseHash)
+                            trace("MANAGER_RESPONSE_COMMITTED", "project=${project.projectId}|sha=${managerResponseHash.take(16)}")
+                        } else {
+                            trace("MANAGER_CURSOR_REBOUND", "project=${project.projectId}|oldManager=${manager.agentId}")
+                        }
