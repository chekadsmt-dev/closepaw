-    private fun mergePages(
-        pages: List<List<String>>
-    ): List<String> {
-        val out =
-            mutableListOf<String>()
-
-        for (page in pages) {
-            if (page.isEmpty()) {
-                continue
-            }
-
-            val maxOverlap =
-                minOf(
-                    out.size,
-                    page.size,
-                    80
-                )
-
-            var overlap = 0
-
-            for (
-                candidate in
-                maxOverlap downTo 1
-            ) {
-                if (
-                    out.takeLast(candidate) ==
-                    page.take(candidate)
-                ) {
-                    overlap =
-                        candidate
-
-                    break
-                }
-            }
-
-            out.addAll(
-                page.drop(overlap)
-            )
-        }
-
-        return out
-    }
