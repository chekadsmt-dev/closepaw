+internal fun configuredConversationTitleMatchesV59(actualRaw: String, configuredRaw: String): Boolean {
+    fun normalized(value: String): String = value
+        .replace('\u00a0', ' ')
+        .replace(Regex("\\s+"), " ")
+        .trim()
+
+    val actual = normalized(actualRaw)
+    val configured = normalized(configuredRaw)
+    if (configured.isBlank()) return false
+    return actual == configured || actual.startsWith("$configured | ")
+}
