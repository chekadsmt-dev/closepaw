+package ai.closepaw.app
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class ChatGptProjectAdapterV59Test {
+    @Test
+    fun configuredTitleAcceptsExactIdentity() {
+        assertTrue(configuredConversationTitleMatchesV59("00 — SMT HQ", "00 — SMT HQ"))
+    }
+
+    @Test
+    fun configuredTitleAcceptsUniqueDescriptorSuffixShape() {
+        assertTrue(configuredConversationTitleMatchesV59("00 — SMT HQ | مدیر کل هلدینگ", "00 — SMT HQ"))
+    }
+
+    @Test
+    fun configuredTitleNormalizesWhitespaceButRejectsFuzzyMatches() {
+        assertTrue(configuredConversationTitleMatchesV59("00 — SMT HQ\u00a0| مدیر", "00 — SMT HQ"))
+        assertFalse(configuredConversationTitleMatchesV59("prefix 00 — SMT HQ | مدیر", "00 — SMT HQ"))
+        assertFalse(configuredConversationTitleMatchesV59("00 — SMT HQ backup", "00 — SMT HQ"))
+        assertFalse(configuredConversationTitleMatchesV59("00 — SMT HQ|مدیر", "00 — SMT HQ"))
+    }
+}
